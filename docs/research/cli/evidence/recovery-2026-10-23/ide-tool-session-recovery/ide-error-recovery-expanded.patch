+        is_error: true,
+        code,
+        error: "provider-private-error",
+        result: "request-private-body",
+        phase: "before-model",
+        persistence: { phase: "secret-phase" },
+      },
+      createTurnState(),
+    );
+    assert.equal(result.code, undefined);
+    assert.equal(result.phase, "unspecified");
