{"type":"context.plan.created","plan":{"schema":"chainlesschain.context-plan/v1","schemaVersion":1,"sessionHead":"sha256:a7a5fbe048077faa0a4943965bfc5688832778e178342f8933619559db204013","memoryRevision":0,"policyVersion":"cli-provider-v1","modelProfile":"model-capability-v1:987cd547e135208a7f4c9e7252dfdc81:sha256:d9a95c2363a4dec72111439b772f12d300beaf767ab5b984a372576a1e48ce39","sink":"provider.volcengine","inputBudget":27034,"selectableBudget":25683,"selectedTokens":2456,"partitions":{"trusted-system":{"ceiling":27034,"used":82},"working-state":{"ceiling":27034,"used":0},"tools-and-skills":{"ceiling":27034,"used":1324},"conversation":{"ceiling":27034,"used":127},"tool-evidence":{"ceiling":27034,"used":923},"memory-and-rules":{"ceiling":3244,"used":0},"recovery-reserve":{"ceiling":1351,"used":1351}},"minimumShortfalls":{},"selected":[{"schemaVersion":1,"itemId":"cli-msg-9c8c60686597c700d14a5f469db42f43-0","kind":"system-policy","scope":"session","scopeId":"headless-1791693178592-25","sourceRef":{"store":"cli-jsonl-session","id":"message-0","eventSequence":0,"digest":"sha256:9c8c60686597c700d14a5f469db42f4374bd4855916e92f3af5a9e18b286878e"},"provenance":{"source":"cli-jsonl-session","observedAt":"1970-01-01T00:00:00.000Z"},"trust":"host","sensitivity":"personal","allowedSinks":["provider.volcengine"],"tokenEstimate":82,"priority":800000,"pinned":false,"createdAt":"1970-01-01T00:00:00.000Z","content":"{\"durableSystemKinds\":[null],\"messages\":[{\"content\":\"You are a hermetic code fixer. The exposed file tools are the complete tool surface. Inspect and mutate only the exact paths authorized in the user request, then return a concise completion message.\",\"role\":\"system\"}],\"schema\":\"chainlesschain.cli-context-message-bundle/v1\"}","digest":"sha256:3056c5e3607ecaa5d349450c82c54b81df045c01b214511e7bbb54f5a8d55a3c"},{"schemaVersion":1,"itemId":"cli-tool-d2e62b8713c083f8fd0229c27b317ea9","kind":"tool-schema","scope":"session","scopeId":"headless-1791693178592-25","sourceRef":{"store":"cli-tool-registry","id":"read_file","digest":"sha256:d2e62b8713c083f8fd0229c27b317ea9585c828f06cf505f129d5e1ff1c2de10"},"provenance":{"source":"cli-tool-registry","observedAt":"1970-01-01T00:00:00.000Z"},"trust":"host","sensitivity":"internal","allowedSinks":["provider.volcengine"],"tokenEstimate":337,"priority":600000,"pinned":false,"createdAt":"1970-01-01T00:00:00.000Z","content":"{\"function\":{\"description\":\"Read a file's content. Use search_files to locate relevant sections and offset+limit to read them. For large files, follow the returned nextRead cursor; range describes only the lines actually returned. Reuse unchanged content already in context instead of re-reading the same page. Jupyter notebooks (.ipynb) are rendered as a compact cell listing for notebook_edit — pass raw:true for underlying JSON.\",\"name\":\"read_file\",\"parameters\":{\"properties\":{\"column\":{\"description\":\"1-based character position within the first rendered line. Use the column from nextRead to continue an oversized single line without repeating its beginning.\",\"minimum\":1,\"type\":\"integer\"},\"hashed\":{\"description\":\"Prefix each line with a 6-char content hash for edit_file_hashed anchoring\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum number of lines to return starting at offset (omit to read to end, subject to the size cap).\",\"type\":\"integer\"},\"offset\":{\"description\":\"1-based line number to start reading from (omit to read from the top). Use with limit to page a large file.\",\"type\":\"integer\"},\"path\":{\"description\":\"File path to read\",\"type\":\"string\"},\"raw\":{\"description\":\"For .ipynb: return the raw notebook JSON instead of the rendered cell listing\",\"type\":\"boolean\"}},\"required\":[\"path\"],\"type\":\"object\"}},\"type\":\"function\"}","digest":"sha256:e6ce4163538c84562418274066404c894d6eb6fb6e73ac60c06b49e92a178f64"},{"schemaVersion":1,"itemId":"cli-tool-5bf05cf51ac27f26a28d6a3786cb206f",