_hash\",\"expected_line\",\"new_line\"],\"type\":\"object\"}},\"type\":\"function\"}","digest":"sha256:aaee310fc143c4974cfb0e71a2e0bf04a3f4fc43dad5b18758eb55d11833d20b"},{"schemaVersion":1,"itemId":"cli-tool-757401606a35f787c889387c88f27cba","kind":"tool-schema","scope":"session","scopeId":"headless-1791693178592-25","sourceRef":{"store":"cli-tool-registry","id":"search_files","digest":"sha256:757401606a35f787c889387c88f27cba60f116afb9e6b906a216d7d274989a56"},"provenance":{"source":"cli-tool-registry","observedAt":"1970-01-01T00:00:00.000Z"},"trust":"host","sensitivity":"internal","allowedSinks":["provider.volcengine"],"tokenEstimate":402,"priority":599996,"pinned":false,"createdAt":"1970-01-01T00:00:00.000Z","content":"{\"function\":{\"description\":\"Search for files by name pattern or content. For a long text file, pass path and pattern: returns matching line/column positions, nearby context, and nextRead arguments for read_file. This streams the file instead of loading it into model context. Continue capped results with nextOffset as offset. Omit path for the existing directory search.\",\"name\":\"search_files\",\"parameters\":{\"properties\":{\"caseSensitive\":{\"description\":\"Single-file search only: match case (default false).\",\"type\":\"boolean\"},\"content_search\":{\"description\":\"If true, search file contents instead of names\",\"type\":\"boolean\"},\"contextChars\":{\"description\":\"Single-file search: characters around each match (default 150).\",\"maximum\":1000,\"minimum\":0,\"type\":\"integer\"},\"directory\":{\"description\":\"Directory to search in (default: cwd)\",\"type\":\"string\"},\"maxMatches\":{\"description\":\"Single-file search: maximum matching excerpts (default 20).\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"},\"offset\":{\"description\":\"Single-file search: zero-based character offset to continue from nextOffset (default 0).\",\"minimum\":0,\"type\":\"integer\"},\"path\":{\"description\":\"One text file to search by literal keyword (takes precedence over directory/content_search).\",\"type\":\"string\"},\"pattern\":{\"description\":\"Glob pattern or search string\",\"type\":\"string\"},\"regex\":{\"description\":\"Single-file search only: evaluate a regular expression in overlapping 64K text windows (default false). Prefer literals for exact coverage across window boundaries.\",\"type\":\"boolean\"}},\"required\":[\"pattern\"],\"type\":\"object\"}},\"type\":\"function\"}","digest":"sha256:5833453d6ae00a0a16046a1635726c77fc52ef7b9b816b6d6fde868e97f41db9"},{"schemaVersion":1,"itemId":"cli-tool-be3979c14f6ea9985a267e3673603eec","kind":"tool-schema","scope":"session","scopeId":"headless-1791693178592-25","sourceRef":{"store":"cli-tool-registry","id":"list_dir","digest":"sha256:be3979c14f6ea9985a267e3673603eeca02f05700690b6d5c1b72d4afc8609d8"},"provenance":{"source":"cli-tool-registry","observedAt":"1970-01-01T00:00:00.000Z"},"trust":"host","sensitivity":"internal","allowedSinks":["provider.volcengine"],"tokenEstimate":53,"priority":599995,"pinned":false,"createdAt":"1970-01-01T00:00:00.000Z","content":"{\"function\":{\"description\":\"List contents of a directory\",\"name\":\"list_dir\",\"parameters\":{\"properties\":{\"path\":{\"description\":\"Directory path (default: cwd)\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"function\"}","digest":"sha256:37af2db87bf040187963e89529c8e8a407007c5543ca7dcef06c9b8e3997e3d7"},{"schemaVersion":1,"itemId":"cli-msg-3b5da5c24ce6564709e4262f18a97e69-1","kind":"message","scope":"session","scopeId":"headless-1791693178592-25","sourceRef":{"store":"cli-jsonl-session","id":"message-1","eventSequence":1,"digest":"sha256:3b5da5c24ce6564709e4262f18a97e69343d946c2a064a946891b84845696854"},"provenance":{"source":"cli-jsonl-session","observedAt":"1970-01-01T00:00:00.001Z"},"trust":"user","sensitivity":"personal","allowedSinks":["provider.volcengine"],"tokenEstimate":127,"priority":500001,"pinned":false,"createdAt":"1970-01-01T00:00:00.001Z","conte