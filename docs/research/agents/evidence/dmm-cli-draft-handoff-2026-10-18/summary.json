  "boundaries": {
    "request": "Strict fixed schema, declared plugin label/declaration digest and exact description proposal. Digests establish consistency only; request metadata does not authenticate plugin code or choose native authority. No connection keys, task snapshots or approval records included.",
    "cli": "Requires explicit live summary/evidence connection and current installed-plugin trust/workspace trust/capability consent/policy. Invocation options/env fixed before await; source ID explicitly copied from desktop; bounded UTF-8 description file read and exclusive output create. Output is request-exported, not a native pending receipt.",
    "nativeAdoption": "Native picker only; renderer cannot submit a path, plugin authority or approval. Read one bounded FD snapshot and confirm full goal/source/body/digest, then revalidate actor/auth generation/window/frame/navigation/database/goal/source. User adopts exact text under fixed native-imported-description identity, origin user-edited. CLI plugin lifecycle does not revoke this separate adoption.",
    "atomic": "Adoption + pending insertion share one immediate native transaction through the trusted enqueueInTransaction composition entry. Failure rolls both back; no task changes, intents or ActionRuns created by adoption.",
    "idempotency": "Actor/native importer/store/goal/request identity is stable. Same payload reimport reads original status; changed payload conflicts. Historical saved status remains visible after source changes. No automatic new request ID after unknown results.",
    "revocation": "Each record has persistent epoch; revoke disables it and advances epoch. Reimport cannot revive it. Conversion and execution verify exact payload, native identity and current adoption epoch. Completed task changes and receipts are not undone.",
    "execution": "Existing durable conversion and native action preview/strict confirmation remain required. Verifier routes by validated draft identity without trying/swallowing unrelated verifiers. Final confirmation identifies adopted external request, declared source and content digest.",
    "ui": "Both IDEs obtain file paths from native pickers; webview path fields ignored. Generation checks discard late results. Desktop failures/source changes clear imported body and parent pending previews; revoke/prepare invalidate before request. Completed history retained.",
    "limits": {
      "requestBytes": 16384,
      "descriptionUtf8Bytes": 8192,
      "adoptionReadBytes": 24576,
      "pendingRecordBytes": 49152,
      "importsPerActorGoal": 100,
      "listPage": 20
    },
    "transport": "Existing v1/v2 HMAC leases retain their prior read-only scopes. No new HTTP write endpoint or persistent plugin delegation grant in this slice."
  },
