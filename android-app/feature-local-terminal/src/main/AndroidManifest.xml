<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PtyEnvironment reads the active network's DNS servers before spawning
         the raw Node subprocess. Keep the permission with the library that
         owns those ConnectivityManager calls instead of relying on :app. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
