---
import BaseLayout from '../layouts/BaseLayout.astro';
import vscodePkg from '../../../packages/vscode-extension/package.json';
import releaseStatus from '../data/release-status.json';

const CLI_VERSION = releaseStatus.recommendedCliVersion;
const SOURCE_CLI_VERSION = releaseStatus.sourceMainCliVersion;
const VSCODE_VERSION = releaseStatus.openVsxVersion;
const VSCODE_SOURCE_VERSION = vscodePkg.version;
const JETBRAINS_VERSION = releaseStatus.jetBrainsMarketplaceVersion;
const JETBRAINS_SOURCE_VERSION = releaseStatus.sourceJetBrainsVersion;
const OPEN_VSX_DOWNLOADS = releaseStatus.openVsxDownloadsMilestone;
const VSCODE_VSIX_URL = `https://open-vsx.org/api/chainlesschain/chainlesschain-ide/${VSCODE_VERSION}/file/chainlesschain.chainlesschain-ide-${VSCODE_VERSION}.vsix`;
---
<BaseLayout
  title="IDE 集成 — VS Code + JetBrains 双扩展，agent 进编辑器 | ChainlessChain"
  description="ChainlessChain IDE 桥接：VS Code（Open VSX）+ JetBrains（Marketplace）双扩展。受治理自动 ghost-text、Automation Center、原生 diff 审批、CLI-owned Sessions、侧边栏 Chat 与 App 预览。"
  canonical="https://www.chainlesschain.com/ide"
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-paper opacity-60 pointer-events-none"></div>
    <div class="container-wide relative pt-20 pb-20 md:pt-28 md:pb-24">
      <div class="max-w-4xl">
        <div class="chip mb-6 animate-fade-in">IDE 集成 · VS Code {VSCODE_VERSION}（Open VSX）+ JetBrains {JETBRAINS_VERSION}</div>
        <h1 class="animate-fade-in-delay font-display text-6xl md:text-display-lg leading-[1.02]">
          agent 进编辑器：<br/><span class="italic text-ember">看你所看，改你所审</span>。
        </h1>
        <p class="animate-fade-in-delay-2 mt-8 text-xl text-muted leading-relaxed max-w-3xl">
          编辑器扩展内置一个本地 MCP server，在集成终端里跑 <code class="font-mono text-base bg-paper border border-line px-2 py-0.5 rounded">cc agent</code> 即自动连接 ——
          编辑器能力变成 agent 工具，agent 的改动经编辑器原生 diff 受你裁决。
        </p>
        <div class="animate-fade-in-delay-3 mt-10 flex flex-wrap gap-3">
          <a href="https://open-vsx.org/extension/chainlesschain/chainlesschain-ide" rel="noopener" target="_blank" class="btn-ember">Open VSX 安装 ↗</a>
          <a href="https://plugins.jetbrains.com/plugin/32208-chainlesschain-ide-bridge" rel="noopener" target="_blank" class="btn-ghost">JetBrains Marketplace ↗</a>
          <a href="https://docs.chainlesschain.com/chainlesschain/ide-bridge.html" rel="noopener" class="btn-ghost">完整文档 ↗</a>
        </div>
        <p class="mt-5 text-sm text-muted">
          当前 VS Code <strong class="text-ink">{VSCODE_VERSION}</strong> 已公开上架 Open VSX，累计下载 <strong class="text-ink">{OPEN_VSX_DOWNLOADS}</strong>；JetBrains <strong class="text-ink">{JETBRAINS_VERSION}</strong> 已公开上架 Marketplace，推荐搭配完整门禁 CLI <strong class="text-ink">{CLI_VERSION}</strong>。公开 listing 与安装制品已回读；微软 VS Code Marketplace 版本仍未发布。
        </p>
        <p class="mt-3 text-sm text-muted">
          公开稳定版为 VS Code <strong class="text-ink">{VSCODE_VERSION}</strong> / JetBrains <strong class="text-ink">{JETBRAINS_VERSION}</strong>；当前分支包元数据分别为 VS Code <strong class="text-ink">{VSCODE_SOURCE_VERSION}</strong> / JetBrains <strong class="text-ink">{JETBRAINS_SOURCE_VERSION}</strong>，源码领先或分支版本漂移不替代市场 tag。CLI <strong class="text-ink">{SOURCE_CLI_VERSION}</strong> 已公开 custody handoff、SessionMessageFabric 与结构化审批。VS Code {VSCODE_VERSION} 以宿主信任的原生选择提供单次、当前回合或当前会话授权，并以不含正文的有界计数展示 canonical message/handoff 状态；Agent Platform 发布不表示所有 IDE 接入都已切换到 CC App Server。
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-4xl md:text-5xl mb-12 max-w-3xl">二十二件事，进编辑器就发生。</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          ['感知', '选区随 prompt 注入', '每条 prompt 自动附带当前选区 + 打开的标签页（<ide-context> 块）——模型即时知道"你正看着什么"，不写入会话持久化。'],
          ['自修', '诊断自动回喂', 'agent 改完文件，语言服务器的 error/warning 自动附回工具结果——同一循环内看到自己引入的报错并修掉。'],
          ['审批', '原生 diff 评审', '文件编辑确认升级为编辑器原生并排 diff：右侧可顺手改、Accept 替代执行、hunk 级"Pick hunks…"部分接受、"Request changes…"行内批注回喂 agent 修订；跨多文件改动走 openMultiDiff 整 changeset 一屏批量评审。Reject 永不写盘。'],
          ['执行', 'Jupyter kernel', 'executeCode 在活跃 notebook 的 kernel 里执行代码并取回输出，变量跨调用保持（VS Code 端）。'],
          ['对话', '侧边栏 Chat 面板', '不开终端直接对话：流式回复 + 工具轨迹 + Plan 模式卡片 + Approve/Deny 审批卡 + 多会话 tab（各自独立 agent 进程、切换恢复 transcript）+ 会话跨重启续接 + /sessions 切换。'],
          ['授权', '精确作用域审批', 'VS Code 0.37.68 的审批卡保留单次批准快速路径，并可明确选择当前回合、当前会话、拒绝或取消。回合/会话 grant 只复用 CLI 请求携带的 exact capability、scope 与 binding，Webview 不能扩权。'],
          ['预览', 'App 内嵌预览', 'Start App Preview 自动识别项目 dev 脚本 → 拉起 dev server → 解析本地 URL → 编辑器内嵌打开（VS Code 内置 Simple Browser / JetBrains JCEF 浏览器，不支持时回退外部浏览器）；dev server 的 HMR 负责改文件即时热重载；dev server 意外退出时报崩溃并一键 Restart，不再默默停掉。'],
          ['终端', '终端上下文共享', 'getTerminalOutput 让 agent 看到你刚在集成终端跑的命令、输出、退出码（VS Code 1.93+ shell integration）——它知道你刚跑了什么、怎么失败的。每轮自动注入 <ide-context> + 显式 @terminal at-mention。'],
          ['质量', '测试 / 覆盖率 / 调试器上下文', 'cc-ide-quality/v1 发送有界质量快照并标记新鲜度；过期结果不会伪装成当前状态，VS Code Notebook 执行携带真实 notebook/cell 上下文。'],
          ['插件', '事务化升级 + 供应链治理', '按 scope 启停；升级先 staging 校验 manifest/签名/SBOM 再原子激活，失败恢复旧版本。IDE 只在 activated 后重载会话，扩大 capability 前要求显式批准。'],
          ['治理', 'Distributed Agent Teams', 'IDE 只读观察本地 team state v6 与独立 distributed queue v1 原始快照；takeover、managed checkpoint recovery 与副作用 adjudication 全部交回 CLI，并绑定 authority digest、lease 与 evidence fence。过期 UI 动作失败闭合，IDE 不直接改权威 JSON。'],
          ['消息', '无正文协作健康投影', 'VS Code 0.37.68 在 TeamMailbox v3 之外展示 canonical message/follow-up 与 custody handoff 的有界状态计数；JetBrains 0.4.98 继续展示 mailbox health。消息正文/摘要、attempt/agent 身份、artifact id 和 authority digest 不进入 Webview，异常投影失败闭合且不影响任务图。'],
          ['归因', '耗时与重试可见', '用量视图展示真实工具耗时、同轮观测重试和脱敏的流式 LLM retry 原因/实际 provider/model，不保存工具参数、输出或凭据。'],
          ['自动化', 'Governed Automation Center', 'Open VSX 0.37.68 与 JetBrains 0.4.98 展示 CLI-owned flow/Routine projection、scope、preflight 与 history。所有变更经 exact revision 与 CLI argv 执行，IDE 不直接写权威存储。'],
          ['产物', '受审计的 Artifact 工作台', '预览、打开、复制路径、reveal 与下载先通过 CLI artifacts access 复核 managed bytes 并写 content-free audit；删除使用稳定 deletion id，响应丢失后按同一 id 回读/恢复，不重复执行。'],
          ['会话', 'CLI-owned Sessions Workbench', '公开版 0.37.68 / 0.4.98 读取 CLI 生成的 immutable session/message projection，展示 delivered、refused、full、expired 结果，并包含分组、多选批量移动与 Focus View；过期动作继续失败闭合。'],
          ['交付', '可恢复 delivery 与 rewind', '公开版覆盖 GitHub、Gitee、configured remote 与 manual handoff；每步校验结果/副作用摘要，rewind 绑定 session、workspace、仓库 head、checkpoint revision 与 manifest digest。'],
          ['上下文', 'Context Center', 'VS Code 0.37.68 与 JetBrains 0.4.98 显示执行位置、workspace authority、会话、工作流与恢复身份，让本地、Remote-SSH、容器和远程协作上下文保持可见。'],
          ['副作用', 'Side-effect Center', '双端汇总权限活动、作用域 grant 与 revoke 入口；所有变更继续通过 CLI 命令和精确上下文执行，IDE 不绕过权威存储。'],
          ['内联', '选区旁直接问与改', 'VS Code 0.37.68 提供独立内联会话、流式响应、代码块操作和交互恢复，并延续 stable/minimum × Linux/Windows/macOS ARM64 多窗口隔离门；Explain / Refactor / Fix / Docs / Tests 已在 Open VSX 公开。'],
          ['同步', 'CLI 版本对齐', '激活时检测 cc --version；当前稳定安装固定到 npm i -g chainlesschain@0.166.3，与已完成完整门禁的 npm latest 一致。'],
          ['补全', '受治理自动 ghost-text', 'Alt+\\ 手动补全保持不变；自动路径默认关闭，启用后采用 650ms 可取消 debounce、exact-context 去重/缓存、独立小时请求与上下文字数预算、有界输出和质量回退。超过 5 秒或质量不足时静默丢弃。'],
        ].map(([tag, title, desc]) => (
          <div class="p-8 rounded-2xl border border-line hover:border-ember transition-colors">
            <div class="font-mono text-xs text-ember mb-3">{tag}</div>
            <h3 class="font-display text-2xl mb-3">{title}</h3>
            <p class="text-muted leading-relaxed text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- cc agent in the terminal -->
  <section class="py-16 md:py-24">
    <div class="container-wide">
      <div class="max-w-3xl mb-10">
        <div class="chip mb-6">集成终端里的 cc agent</div>
        <h2 class="text-4xl md:text-5xl leading-tight">
          扩展只是桥，<br/><span class="italic text-ember">真正干活的是 cc agent</span>。
        </h2>
        <p class="mt-6 text-lg text-muted">
          在编辑器集成终端里跑 <code class="font-mono text-sm bg-paper border border-line px-2 py-0.5 rounded">cc agent</code> 即自动连上扩展的 MCP server——上述能力就是这么发生的。
          同一个 agent 还带一整套伴生命令：权限网关、检查点回滚、花费统计、循环自动化、结构化输出，在 IDE 里和在裸终端里完全一致。
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          ['cc agent', '集成终端内自动连接编辑器 —— 选区注入、诊断回喂、原生 diff 审批全部生效'],
          ['cc agent -p "…"', '无头单轮执行，进 CI / 任务脚本（text / json / stream-json 输出）'],
          ['cc ide doctor', '诊断桥接为何连上 / 连不上（无锁 / stale / workspace 不匹配）'],
          ['cc permissions', '.claude/settings.json 权限规则 allow / ask / deny + 凭据读取保护'],
          ['cc checkpoint', 'git 仓内默认自动快照，改坏一键 restore 回滚'],
          ['cc cost / cc loop / cc goal', '花费统计、定时循环、跨会话持久目标'],
        ].map(([cmd, desc]) => (
          <div class="p-6 rounded-xl bg-paper border border-line">
            <code class="font-mono text-sm text-ember">{cmd}</code>
            <p class="text-sm text-muted mt-2">{desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="https://docs.chainlesschain.com/chainlesschain/cli-agent-mode.html" rel="noopener" class="btn-ghost">Agent 模式命令大全 ↗</a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-cream/50 border-y border-line">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl mb-6 font-display">两步装好</h2>
        <ol class="space-y-4 text-muted leading-relaxed">
          <li><strong class="text-ink">1. 装 CLI：</strong><code class="font-mono text-sm bg-paper border border-line px-2 py-0.5 rounded">npm i -g chainlesschain@{CLI_VERSION}</code>（推荐完整门禁版 <code class="font-mono text-sm">{CLI_VERSION}</code>，桥接最低 <code class="font-mono text-sm">0.162.47</code>；<code class="font-mono text-sm">cc ide doctor</code> 可诊断连接）</li>
          <li><strong class="text-ink">2. 装扩展：</strong>VSCodium / Cursor 等在扩展面板搜 <strong class="text-ink">ChainlessChain IDE</strong>（Open VSX 当前 <code class="font-mono text-sm">{VSCODE_VERSION}</code>）；IDEA / PyCharm / WebStorm 在 Settings → Plugins → Marketplace 搜同名（当前 <code class="font-mono text-sm">{JETBRAINS_VERSION}</code>，2024.2+）。官方版 VS Code 不查询 Open VSX，请不要点 Open VSX 的通用 Install 链接；直接下载 <a class="underline" href={VSCODE_VSIX_URL}>v{VSCODE_VERSION} VSIX</a>，再运行 <strong class="text-ink">Extensions: Install from VSIX...</strong>。</li>
        </ol>
        <p class="mt-6 text-sm text-muted">
          安全默认：server 仅绑定 localhost + 每实例随机 Bearer token + 锁文件 0600；CLI 端 <code class="font-mono text-xs">--no-ide</code> / <code class="font-mono text-xs">CC_IDE_CONTEXT=0</code> / <code class="font-mono text-xs">CC_IDE_DIFF_APPROVAL=0</code> 随时关闭对应行为。
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 text-center">
    <div class="container-wide">
      <h2 class="text-4xl md:text-5xl mb-6">协议、排错、架构细节</h2>
      <p class="text-muted mb-8">发现协议（lockfile + env 直连）、Streamable HTTP、双编辑器零改动设计 —— 都在文档站。</p>
      <a href="https://docs.chainlesschain.com/chainlesschain/ide-bridge.html" rel="noopener" class="btn-ember">阅读 IDE 桥接文档 ↗</a>
    </div>
  </section>
</BaseLayout>
