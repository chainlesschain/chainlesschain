import BaseLayout from '../layouts/BaseLayout.astro';
import releaseStatus from '../data/release-status.json';
import { parseChangelog } from '../../../packages/cli/src/lib/changelog.js';
import { readFileSync } from 'node:fs';

const CLI_VERSION = releaseStatus.recommendedCliVersion;
const NPM_LATEST_CLI_VERSION = releaseStatus.npmLatestCliVersion;
const SOURCE_CLI_VERSION = releaseStatus.sourceMainCliVersion;
const CLI_RELEASE_TAG = releaseStatus.cliReleaseTag;
const CLI_RELEASE_COMMIT = releaseStatus.cliReleaseCommit.slice(0, 10);
const SOURCE_CANDIDATE_COMMIT = releaseStatus.sourceCandidateCommit.slice(0, 10);
const DESKTOP_SOURCE_COMMIT = releaseStatus.documentedDesktopCommit.slice(0, 10);
const AGENT_SDK_VERSION = releaseStatus.agentSdkVersion;
const PYTHON_AGENT_SDK_VERSION = releaseStatus.pythonAgentSdkVersion;

// Recent CLI (npm) updates, derived from the root CHANGELOG.md at BUILD time via
// the same parser that powers `cc changelog`. No committed snapshot to go stale:
// every site rebuild re-reads the source of truth, so a redeploy after any
// release reflects the latest npm versions automatically.
const CLI_UPDATES = parseChangelog(
  readFileSync(new URL('../../../CHANGELOG.md', import.meta.url), 'utf-8'),
)
  .slice(0, 6)
  .map((r) => ({
    version: r.cliVersion,
    date: r.date,
    productVersion: r.productVersion,
    summary: (r.sections[0]?.heading || r.title || '')
      .replace(/^(chore|feat|fix|docs|refactor|perf|style|test)(\([^)]*\))?:\s*/i, '')
      .replace(/^\W*(Fixed|Added|Changed|Tests|Security|Feat|Fix|chore|Removed|Deprecated)\b[^—]*—+\s*/i, '')
      .trim(),
    status:
      r.cliVersion === CLI_VERSION
        ? '生产推荐 · 完整门禁'
        : r.cliVersion === NPM_LATEST_CLI_VERSION
          ? 'npm latest'
          : r.cliVersion === SOURCE_CLI_VERSION
            ? '源码快照'
            : '历史版本',
  }));

