---
import BaseLayout from '../layouts/BaseLayout.astro';
import MobileFeatureMap from './MobileFeatureMap.astro';
import releaseSizes from '../data/release-sizes.json';
import releaseStatus from '../data/release-status.json';
import { productPages } from '../data/product-pages';

const { product, lang = 'zh' } = Astro.props;
const en = lang === 'en';
const content = productPages[product][lang];
const cliVersion = releaseStatus.recommendedCliVersion;
const version = product === 'web' ? cliVersion : releaseSizes.productVersion;
const prefix = en ? '/en' : '';
const doc = `https://docs.chainlesschain.com/chainlesschain/${productPages[product].doc}.html`;
const heroRoute = product === 'desktop' ? 'chat' : 'cowork';
const gallery = product === 'web' ? ['cowork', 'evolution-settings'] : ['chat', 'skills', 'evolution-settings'];
const captions = en ? { cowork: 'Cowork · templates and task input', chat: 'AI chat · a fresh session workspace', skills: 'Skills · discovery and management', 'evolution-settings': 'Evolution settings · off by default' } : { cowork: 'Cowork · 任务模板与需求输入', chat: 'AI 对话 · 新建会话工作区', skills: 'Skills · 技能发现与管理', 'evolution-settings': '自进化设置 · 默认关闭' };
const keys = product === 'desktop'
  ? [['win-setup','Windows Setup'],['win-portable','Windows Portable'],['mac-intel','macOS Intel'],['mac-arm64','macOS Apple Silicon'],['linux-appimage','Linux AppImage'],['linux-deb','Linux DEB'],['linux-rpm','Linux RPM']]
  : [['android-arm64-v8a','Android arm64-v8a'],['android-armeabi-v7a','Android armeabi-v7a'],['android-universal','Android universal'],['android-aab','Android AAB'],['ios-ipa','iOS ad-hoc IPA']];
const downloads = keys.flatMap(([key,label]) => {
  const asset = releaseSizes.sizes[key];
  return asset ? [{...asset,label,href:`https://github.com/chainlesschain/chainlesschain/releases/download/${releaseSizes.tag}/${encodeURIComponent(asset.name)}`}]:[];
});
const install = `npm i -g chainlesschain@${cliVersion}\ncc ui\n\n# http://localhost:18810/#/cowork`;
---
<BaseLayout title={`${content.name} ${version} | ChainlessChain`} description={content.description} canonical={`https://www.chainlesschain.com${prefix}/${product}`} locale={lang}>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-paper opacity-60 pointer-events-none"></div>
    <div class="container-wide relative pt-20 pb-16 md:pt-28 md:pb-20">
      <div class="max-w-4xl">
        <div class="flex flex-wrap gap-3 mb-7"><span class="chip">{content.name} · {version}</span><span class="chip">{en ? 'Updated 2026-10-28' : '更新于 2026-10-28'}</span></div>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.12]">{content.title}</h1>
        <p class="mt-8 text-xl text-muted leading-relaxed max-w-3xl">{content.intro}</p>
        <div class="mt-10 flex flex-wrap gap-3"><a class="btn-ember" href={product === 'web' ? '#start' : '#download'}>{content.primary} ↓</a><a class="btn-ghost" href={doc}>{content.secondary}</a></div>
        <p class="mt-6 text-sm text-muted">{en ? 'Public pairing' : '当前公开配对'}: CLI {cliVersion} · {releaseSizes.productVersion}</p>
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="container-wide">
      {product === 'mobile' ? <MobileFeatureMap lang={lang} /> : (
        <figure class="border border-line rounded-2xl overflow-hidden shadow-xl bg-paper">
          <img src={`/screenshots/panel-${heroRoute}-20261028-${lang}.png`} alt={captions[heroRoute]} width="1440" height="960" loading="eager" class="block w-full h-auto" />
          <figcaption class="px-5 py-4 border-t border-line text-sm text-muted">{captions[heroRoute]} · {en ? 'Captured 2026-10-28 from the current shared Web Shell' : '2026-10-28 当前共享 Web Shell 实拍'}</figcaption>
        </figure>
      )}
      <p class="mt-5 text-sm text-muted leading-relaxed max-w-4xl">{content.privacy}</p>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-cream/40 border-y border-line">
    <div class="container-wide">
      <h2 class="font-display text-3xl md:text-5xl leading-tight max-w-3xl mb-10">{content.section}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {content.features.map(([title,description],i)=>(<article class="p-7 rounded-2xl border border-line bg-paper"><div class="font-mono text-xs text-ember mb-4">0{i+1}</div><h3 class="font-display text-2xl mb-3">{title}</h3><p class="text-sm text-muted leading-relaxed">{description}</p></article>))}
      </div>
    </div>
  </section>

  {product !== 'mobile' && <section class="py-16 md:py-24"><div class="container-wide"><h2 class="font-display text-3xl md:text-4xl mb-9">{en ? 'Explore the current interface' : '看看当前界面'}</h2><div class="grid md:grid-cols-2 gap-6">{gallery.filter(route=>route!==heroRoute).map(route=>(<figure class="rounded-xl overflow-hidden border border-line bg-paper"><a href={`/screenshots/panel-${route}-20261028-${lang}.png`} target="_blank" rel="noopener"><img src={`/screenshots/panel-${route}-20261028-${lang}.png`} alt={captions[route]} width="1440" height={route === 'evolution-settings' ? 520 : 960} loading="lazy" class="w-full h-auto" /></a><figcaption class="p-4 text-sm text-muted">{captions[route]}</figcaption></figure>))}</div><p class="mt-5 text-xs text-muted">{en ? 'Fresh isolated profile, with no seeded conversations or model requests. Some modules currently retain Chinese labels.' : '隔离配置下的新工作区，未填充演示对话，也未发出模型请求。'}</p></div></section>}

  <section id={product === 'web' ? 'start' : 'download'} class="py-20 md:py-24 scroll-mt-24">
    <div class="container-wide">
      <div class="max-w-3xl mb-10"><span class="chip mb-5">{en ? 'GET STARTED' : '开始使用'} · {version}</span><h2 class="font-display text-3xl md:text-5xl leading-tight mb-6">{content.start}</h2><p class="text-muted leading-relaxed">{content.startNote}</p></div>
      {product === 'web' ? <pre class="p-7 rounded-2xl border border-line bg-cream/50 font-mono text-sm overflow-x-auto leading-relaxed"><code>{install}</code></pre> : <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{downloads.map(asset=>(<a class="group block rounded-2xl border border-line p-7 hover:border-ember hover:bg-ember/5 transition-colors" href={asset.href} rel="noopener"><h3 class="font-display text-2xl mb-3">{asset.label}</h3><p class="font-mono text-xs text-muted break-all mb-4">{asset.name}</p><span class="text-sm text-ember">{en ? 'Download' : '下载'} · {asset.bytes ? `${Math.round(asset.bytes/1024/1024)} MB` : ''} ↓</span></a>))}</div>}
      <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3 text-sm"><a class="text-ember hover:underline" href={`https://github.com/chainlesschain/chainlesschain/releases/tag/${releaseSizes.tag}`}>{en ? 'Release assets ↗' : '全部发行文件 ↗'}</a><a class="text-ember hover:underline" href={releaseStatus.releaseEvidence}>{en ? 'Publication verification ↗' : '发行核验记录 ↗'}</a><a class="text-ember hover:underline" href={`${prefix}/${product === 'desktop' ? 'web' : 'desktop'}`}>{en ? (product === 'desktop' ? 'Explore Web →' : 'Explore Desktop →') : (product === 'desktop' ? '了解 Web 版 →' : '了解桌面版 →')}</a></div>
    </div>
  </section>
</BaseLayout>
