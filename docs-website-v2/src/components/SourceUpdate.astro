---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const solCoverage = releaseStatus.solTaskCoverage;
const jetBrainsPending = [
  "pending-review",
  "pending-approval",
  "published-unverified",
  "uploaded_public_listing_pending",
  "uploaded-pending-review",
].includes(releaseStatus.jetBrainsPublicationStatus);
const items = english
  ? [["Verified upgrade pairing", "Public CLI .146, Session Core .27 and both IDEs; restart the host and run Doctor after upgrading."], ["Model-input diagnostics and recovery", "Published CLI diagnostics distinguish input selection, physical dispatch and independent acceptance; cross-entry journeys remain scoped."], ["Memory, MCP Tasks and pricing", "Revision-checked Memory correction, durable MCP continuation and explicit output caps retain their documented runtime and acceptance limits."]]
  : [["已核对的配套升级", "CLI .146、Session Core .27 与两款 IDE 已公开；升级后重启宿主并运行 Doctor。"], ["模型输入诊断与恢复", "公开 CLI 区分输入选择、实际发送和独立验收，提供会话恢复与只读诊断；跨入口旅程按证据范围判断。"], ["Memory、MCP Tasks 与费用", "本版提供受修订校验的 Memory 修正、持久 MCP 续跑及显式输出上限；真实宿主与模型验收仍分别记录。"]];
---

<section class="py-16 border-t border-line bg-cream" aria-labelledby="source-update-title">
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} · {english ? "Verified public release" : "已核验公开发行"} · CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english ? "CLI and IDE upgrade pairing" : "CLI 与 IDE 配套升级"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? `CLI ${releaseStatus.recommendedCliVersion} and Session Core ${releaseStatus.sessionCoreVersion} are public; npm archive integrity and provenance metadata were read back. Open VSX ${releaseStatus.openVsxVersion} and JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} both recommend this CLI; public archives and pairing were checked; official artifact parity was not rerun in this review. Native product ${releaseStatus.productVersion} is independently public.`
        : `CLI ${releaseStatus.recommendedCliVersion} 与 Session Core ${releaseStatus.sessionCoreVersion} 已公开，本轮核对 npm 归档完整性与来源元数据；Open VSX ${releaseStatus.openVsxVersion} 和 JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} 均推荐该 CLI，已核对公开下载及配对；本轮未重跑与官方制品的全量一致性比较。客户端 ${releaseStatus.productVersion} 已独立公开。`}
    </p>
    <p class="mt-3 text-sm text-muted">
      {english ? releaseStatus.productCandidateStatusEn : releaseStatus.productCandidateStatusZh}
      {english ? " New native v6 creation/model drafts require matching newer desktop builds. " : " 新增原生 v6 创建/模型草稿需要匹配的新桌面构建。"}
      <a class="text-ember hover:underline" href={releaseStatus.productCandidateWorkflow}>{english ? "Client release evidence ↗" : "客户端发行证据 ↗"}</a>
    </p>
    {jetBrainsPending && (
      <p class="mt-3 text-sm text-muted">
        {english
          ? `JetBrains ${releaseStatus.jetBrainsCandidateVersion} passed its official release workflow and was uploaded; public listing/download verification remains pending. This build recommends CLI ${releaseStatus.jetBrainsCandidateRecommendedCliVersion} and can be sideloaded from official Actions artifacts.`
          : `JetBrains ${releaseStatus.jetBrainsCandidateVersion} 已通过正式发布工作流并上传，公开上架与下载仍待核验。该构建推荐 CLI ${releaseStatus.jetBrainsCandidateRecommendedCliVersion}，可从正式 Actions 制品手动侧载。`}
      </p>
    )}
    <p class="mt-3 text-sm text-muted">
      {english
        ? "Public CLI .146 includes goal transfer-to-project and signed restore-transfer commands. Native import requires a matching newer desktop build and explicit confirmation; imported goals remain paused. The .146 release adds Memory corrections and durable continuation; later main-only diagnostics and native-client acceptance remain separately scoped."
        : "公开 CLI .146 已包含 goal transfer-to-project 与签名 restore-transfer 命令。原生导入仍需匹配的新桌面构建和显式确认，新目标保持暂停。本版公开 Memory 修正与持久续跑；后续仅主线的诊断变化和原生客户端验收仍单独记录。"}
      <a class="text-ember hover:underline" href={releaseStatus.unreleasedGoalTransfer.designUrl}>{english ? " Handoff design ↗" : " 移交设计 ↗"}</a>
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <aside id="sol-verification" class="mt-8 rounded-xl border border-line bg-paper p-6" aria-labelledby="sol-verification-title">
      <p class="font-mono text-sm text-ember">OpenAI / {solCoverage.model}</p>
      <h3 id="sol-verification-title" class="mt-2 text-2xl font-bold">
        {english ? "Sol: all 36+9 tasks have accepted results" : "Sol：36+9 项任务累计全部通过"}
      </h3>
      <dl class="mt-6 grid grid-cols-3 gap-4">
        <div>
          <dt class="text-sm text-muted">{english ? "Project tasks" : "项目维护任务"}</dt>
          <dd class="mt-2 text-3xl font-bold">{solCoverage.tasks.accepted}/{solCoverage.tasks.total}</dd>
        </div>
        <div>
          <dt class="text-sm text-muted">{english ? "Independent first runs" : "独立首次安装"}</dt>
          <dd class="mt-2 text-3xl font-bold">{solCoverage.firstRuns.accepted}/{solCoverage.firstRuns.total}</dd>
        </div>
        <div>
          <dt class="text-sm text-muted">{english ? "Cumulative task coverage" : "累计任务覆盖"}</dt>
          <dd class="mt-2 text-3xl font-bold">{solCoverage.accepted}/{solCoverage.total}</dd>
        </div>
      </dl>
      <p class="mt-5 text-sm text-muted leading-relaxed">
        {english
          ? "All 45 sample IDs have a model-native result that completed generation and passed independent acceptance; manually assisted repairs are excluded. This is cumulative coverage across versions, including retests on repaired project sources. The original frozen-project record remains 41/45; this is not a single same-version, same-source 45-task run."
          : "45 个样本均已有模型原生候选正常完成生成并通过独立验收的记录，未混入人工辅助修复。该成绩为跨版本累计覆盖，包含修复项目源码后的补测；原冻结项目历史记录仍为 41/45，不等同于同版本、同源码的一次全量通过。"}
      </p>
      <a class="mt-4 inline-block text-sm text-ember hover:underline" href={solCoverage.evidenceUrl}>
        {english ? "View the 45-sample ledger and original evidence ↗" : "查看 45 项累计账本与原始证据 ↗"}
      </a>
    </aside>
    <p class="mt-6 text-sm text-muted">
      {english
        ? `Public .138 retest: 2/4 accepted. verify-08 and verify-36 passed candidate tests but exhausted 20/20 author turns before review. All 80/80 physical requests have complete usage records. Sol original frozen-project history ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}, previous .137 0/5 and the image follow-up 0/1 retain separate scopes. Accepted samples are skipped in later retests; engineering checks and publication add no model acceptance.`
        : `公开 .138 四项复验 2/4：verify-08、verify-36 的候选测试通过，但作者阶段 20/20 轮耗尽，未进入审阅，仍失败。80/80 个物理请求用量完整。Sol 原冻结项目历史 ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}、前轮 .137 的 0/5 与图像专项 0/1 分别保留；已通过项后续跳过，工程检查与发布不增加模型通过数。`}
    </p>
    <p class="mt-3 text-sm text-muted">
      {english
        ? `No new .146 model-task acceptance; two prior synthetic drafts used 1,176 tokens with unknown cost. Volcengine corrected .140 round: generation39/45, strict24/45; historical36/45,9 remaining, including verify-06 candidate-only qualification. Sol original frozen41/45, cross-version45/45 and separate repaired four2/4 remain distinct. NOT_PAID_READY / NOT_ADMITTED / HOLD remain. Microsoft Marketplace is deferred.`
        : `本次 .146 未新增模型任务验收；此前两项合成草稿共 1176 tokens，费用未知。火山 .140 修正轮生成39/45、严格24/45；历史累计36/45、剩9，保留 verify-06 仅候选通过的限定。Sol 原冻结41/45、跨版本45/45、独立修正四项2/4分别保留。NOT_PAID_READY / NOT_ADMITTED / HOLD 保留，Microsoft Marketplace 暂缓。`}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn-ghost" href={`https://open-vsx.org/api/chainlesschain/chainlesschain-ide/${releaseStatus.openVsxVersion}/file/chainlesschain.chainlesschain-ide-${releaseStatus.openVsxVersion}.vsix`}>{english ? "Download VSIX" : "下载 VSIX"} {releaseStatus.openVsxVersion} ↗</a>
      <a class="btn-ghost" href="https://plugins.jetbrains.com/plugin/32208-chainlesschain-ide-bridge/versions">{english ? "JetBrains public versions" : "JetBrains 公开版本"} ↗</a>
      {jetBrainsPending && <a class="btn-ghost" href={releaseStatus.jetBrainsCandidateArtifactsUrl}>{english ? "Official pending-review build" : "官方待审构建"} {releaseStatus.jetBrainsCandidateVersion} ↗</a>}
      <a class="btn-ghost" href={releaseStatus.upgradeGuide}>{english ? "Upgrade guide ↗" : "升级指南 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.evolutionConfigurationGuide}>{english ? "Self-evolution settings ↗" : "自进化开关配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.recoveryGuide}>{english ? "Image budgets and recovery ↗" : "图片预算与恢复 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.runtimeDesign}>{english ? "Runtime design ↗" : "运行时设计 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.releaseEvidence}>{english ? "Publication evidence ↗" : "发布核验回执 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-agent.html">{english ? "Agent conditions and review ↗" : "Agent 完成条件与复查 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-tool-search.html">{english ? "MCP catalog configuration ↗" : "MCP 目录配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.documentationReview.evidenceUrl}>{english ? "Documentation review ↗" : "代码与文档核对记录 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/goal-drafts-current.html">{english ? "Goal draft guide ↗" : "目标草稿指南 ↗"}</a>
    </div>
  </div>
</section>
