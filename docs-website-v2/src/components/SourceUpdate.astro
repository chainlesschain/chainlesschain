---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const jetBrainsPending = ["pending-review", "pending-approval", "published-unverified"].includes(
  releaseStatus.jetBrainsPublicationStatus,
);
const items = english
  ? [
      [
        "Optional self-evolution",
        "Fresh installations and older automatically generated local deployments default to off. CLI, cc ui and IDEs share evolution.enabled; an explicit false overrides deployment environment variables. Restart running Agent sessions after switching.",
      ],
      [
        "Complete recovery summaries",
        "File excerpts, remote reads, task checkpoints and worklog views retain complete bounded JSON or explicitly omit unsafe excerpts. Original session history, strict validation and redaction remain enforced.",
      ],
      [
        "Mobile and PC release",
        "Five-platform builds passed for v5.0.3.142. All 22 public assets match the CI manifest, and desktop updater metadata is verified. Android terminal controls share the CLI switch; platform signing and installation requirements still apply.",
      ],
    ]
  : [
      [
        "自进化可选开启",
        "新安装与旧自动本地部署默认关闭。CLI、cc ui 和 IDE 共享 evolution.enabled；显式 false 覆盖部署环境变量。切换后需重启运行中的 Agent。",
      ],
      [
        "完整、有界的恢复摘要",
        "文件摘录、远端读取、任务检查点与 WORKLOG 保留完整有界 JSON，无法安全表达时明确省略。原始会话历史、严格校验与脱敏继续保留。",
      ],
      [
        "移动与 PC 产品已公开",
        "v5.0.3.142 五平台构建通过，22 个公开资产匹配 CI 清单，桌面更新元数据已核验。Android 本地终端提供共享开关；签名和安装仍遵循对应平台要求。",
      ],
    ];
---

<section class="py-16 border-t border-line bg-cream" aria-labelledby="source-update-title">
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} · {english ? "Verified public release" : "已核验公开发行"} · CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english ? "Optional self-evolution and complete session recovery" : "可选自进化与完整会话恢复"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? `CLI ${releaseStatus.recommendedCliVersion}, Open VSX ${releaseStatus.openVsxVersion} and JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} are publicly verified. Both IDEs recommend CLI ${releaseStatus.recommendedCliVersion}. Session Core ${releaseStatus.sessionCoreVersion} and Personal Data Hub ${releaseStatus.personalDataHubVersion} were published before the CLI. Native product ${releaseStatus.productVersion} remains a separate download.`
        : `CLI ${releaseStatus.recommendedCliVersion}、Open VSX ${releaseStatus.openVsxVersion} 与 JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} 均已公开核验，两个 IDE 均推荐 CLI ${releaseStatus.recommendedCliVersion}。Session Core ${releaseStatus.sessionCoreVersion} 和 Personal Data Hub ${releaseStatus.personalDataHubVersion} 已先于 CLI 发布；原生产品 ${releaseStatus.productVersion} 继续独立下载升级。`}
    </p>
    {jetBrainsPending && (
      <p class="mt-3 text-sm text-muted">
        {english
          ? `The newer JetBrains ${releaseStatus.jetBrainsCandidateVersion} upload awaits public listing and download verification.`
          : `较新的 JetBrains ${releaseStatus.jetBrainsCandidateVersion} 已上传，公开上架与下载仍待核验。`}
      </p>
    )}
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {english
        ? `No new live model-task acceptance was run for this release. Historical cross-version acceptance remains ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}, with ${releaseStatus.remainingUnaccepted} unaccepted. NOT_PAID_READY, NOT_ADMITTED and automatic promotion HOLD remain.`
        : `本轮未新增真实模型任务验收。跨版本历史合格交付仍为 ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}，剩余 ${releaseStatus.remainingUnaccepted} 项；NOT_PAID_READY、NOT_ADMITTED 与自动晋升 HOLD 保留。`}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn-ghost" href={releaseStatus.upgradeGuide}>{english ? "Upgrade guide ↗" : "升级指南 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.evolutionConfigurationGuide}>{english ? "Self-evolution settings ↗" : "自进化开关配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.recoveryGuide}>{english ? "Image budgets and recovery ↗" : "图片预算与恢复 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.runtimeDesign}>{english ? "Runtime design ↗" : "运行时设计 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.releaseEvidence}>{english ? "Publication evidence ↗" : "发布核验回执 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/goal-drafts-current.html">{english ? "Goal draft guide ↗" : "目标草稿指南 ↗"}</a>
    </div>
  </div>
</section>
