---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const jetBrainsPending = releaseStatus.jetBrainsPublicationStatus !== "verified";
const items = english
  ? [
      ["Keep recovery context after compaction", "Compaction stops with context_over_budget if it would empty a nonempty context or drop its new summary. The original session context and head remain intact."],
      ["Account for completed model usage", "Completed provider usage is settled even when a summary is rejected. Unknown usage or failed settlement stops a paid retry; uncertain task commits require reconciliation."],
      ["Recover VS Code drafts", "Composer drafts reload after reset, session resume and closing the last tab, with retry for failed loads. Connection tests distinguish local dependencies from provider errors."],
    ]
  : [
      ["压缩失败时保留恢复上下文", "压缩若会清空非空上下文或丢失新摘要，就以 context_over_budget 停止，原会话内容与 head 保持原样。"],
      ["结算已发生的模型用量", "摘要被拒绝时仍结算已完成的 provider 用量；用量未知或结算失败会停止付费重试，结果不确定的任务需先对账。"],
      ["恢复 VS Code 草稿", "重置、恢复会话和关闭最后标签后可重新加载草稿，失败可重试。连接测试区分本地依赖问题与服务提供方错误。"],
    ];
---

<section class="py-16 border-t border-line bg-cream" aria-labelledby="source-update-title">
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} · {english ? "Public release and current source" : "公开发布与主线源码"} · CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english ? "Safer compaction and recoverable drafts" : "上下文压缩更安全，聊天草稿可恢复"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? "CLI " + releaseStatus.recommendedCliVersion + " and Open VSX " + releaseStatus.openVsxVersion + " are publicly verified; Open VSX recommends CLI " + releaseStatus.openVsxRecommendedCliVersion + ". Public JetBrains " + releaseStatus.jetBrainsMarketplaceVersion + " recommends CLI " + releaseStatus.jetBrainsRecommendedCliVersion + ". Native product " + releaseStatus.productVersion + " remains a separate download."
        : "CLI " + releaseStatus.recommendedCliVersion + " 与 Open VSX " + releaseStatus.openVsxVersion + " 已公开核验；Open VSX 推荐 CLI " + releaseStatus.openVsxRecommendedCliVersion + "。公开 JetBrains " + releaseStatus.jetBrainsMarketplaceVersion + " 推荐 CLI " + releaseStatus.jetBrainsRecommendedCliVersion + "。原生产品 " + releaseStatus.productVersion + " 仍单独下载升级。"}
    </p>
    {jetBrainsPending && <p class="mt-3 text-sm text-muted">
      {english ? "JetBrains " + releaseStatus.jetBrainsCandidateVersion + " is a source candidate; public listing and download are not yet verified." : "JetBrains " + releaseStatus.jetBrainsCandidateVersion + " 是源码候选，公开上架与下载尚未核验。"}
    </p>}
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {english ? "Formal model evaluation and full native acceptance remain open. Durable budget authority code is included, but paid evaluation is not ready." : "正式模型评测和完整原生验收仍待完成。耐久预算 authority 代码已包含，但正式付费评测仍未就绪。"}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-ide-update-2026-10-15.html">{english ? "Upgrade and troubleshooting ↗" : "升级与故障排查 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/agent-platform-release.html">{english ? "Release guide ↗" : "发布与升级指南 ↗"}</a>
      <a class="btn-ghost" href="https://design.chainlesschain.com/release-runtime-update-2026-10-15.html">{english ? "Architecture and acceptance ↗" : "架构与验收范围 ↗"}</a>
    </div>
  </div>
</section>
