---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const items = english
  ? [
      [
        "Reliable permission writes",
        "Concurrent settings writers get a fair retry window. Owner identity, the two-second deadline and synchronous permission revocation remain enforced.",
      ],
      [
        "Visible approvals and useful diagnostics",
        "JetBrains approval cards refresh their allocated height. Host diagnostics retain layout and menu evidence; restart the upgraded chat host and run Doctor.",
      ],
      [
        "Windows evidence and acceptance",
        "Private toolchain and process cleanup diagnostics retain actual failures. Formal evaluation and full native review remain open; automatic promotion stays HOLD.",
      ],
    ]
  : [
      [
        "可靠的并发权限设置",
        "多个进程写设置时获得公平重试窗口，继续核对 owner 身份、两秒截止及同步权限撤销。",
      ],
      [
        "可见的审批与宿主诊断",
        "JetBrains 审批卡片重新分配视图高度，诊断保留布局和菜单证据；升级后重启聊天宿主并运行 Doctor。",
      ],
      [
        "Windows 取证与验收范围",
        "私有工具链和进程清理诊断保留真实失败；正式评测与完整 native review 仍待验收，自动晋升保持 HOLD。",
      ],
    ];
---

<section
  class="py-16 border-t border-line bg-cream"
  aria-labelledby="source-update-title"
>
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} ·{" "}
      {english ? "Public release and current source" : "公开发布与主线源码"} ·
      CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english
        ? "Reliable settings, visible approvals and traceable evidence"
        : "可靠设置、可见审批、可追溯证据"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? "CLI " +
          releaseStatus.recommendedCliVersion +
          ", SDK " +
          releaseStatus.agentSdkVersion +
          ", Open VSX " +
          releaseStatus.openVsxVersion +
          " and JetBrains " +
          releaseStatus.jetBrainsMarketplaceVersion +
          " are public; both IDEs recommend the current CLI. Native product " +
          releaseStatus.productVersion +
          " is available separately. Upgrade the paired IDE, restart its chat host and run Doctor."
        : "CLI " +
          releaseStatus.recommendedCliVersion +
          "、SDK " +
          releaseStatus.agentSdkVersion +
          "、Open VSX " +
          releaseStatus.openVsxVersion +
          " 和 JetBrains " +
          releaseStatus.jetBrainsMarketplaceVersion +
          " 已公开，两个 IDE 均推荐当前 CLI。原生产品 " +
          releaseStatus.productVersion +
          " 单独下载升级；安装配对 IDE 后重启聊天宿主并运行 Doctor。"}
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <div class="mt-6 flex flex-wrap gap-4">
      <a
        class="btn-ghost"
        href="https://docs.chainlesschain.com/chainlesschain/cli-ide-update-2026-10-10.html"
      >
        {english ? "Upgrade and troubleshooting ↗" : "升级与故障排查 ↗"}
      </a>
      <a
        class="btn-ghost"
        href="https://docs.chainlesschain.com/chainlesschain/agent-platform-release.html"
      >
        {english ? "Release guide ↗" : "发布与升级指南 ↗"}
      </a>
      <a
        class="btn-ghost"
        href="https://docs.chainlesschain.com/chainlesschain/rrsi-current.html"
      >
        {english ? "RRSI evidence and limits ↗" : "RRSI 证据与边界 ↗"}
      </a>
      <a
        class="btn-ghost"
        href="https://design.chainlesschain.com/release-runtime-update-2026-10-10.html"
      >
        {english ? "Architecture and contracts ↗" : "架构与契约 ↗"}
      </a>
    </div>
  </div>
</section>
