---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const jetBrainsPending = [
  "pending-review",
  "pending-approval",
  "published-unverified",
  "uploaded_public_listing_pending",
].includes(releaseStatus.jetBrainsPublicationStatus);
const items = english
  ? [
      ["Keep the current task when output stops", "An output limit or provider filter no longer counts as completion. The current task stays available so you can see why it stopped and decide what to do next."],
      ["Do not run incomplete tool requests", "Tools from a truncated or filtered response are not executed. After truncation, at most one fresh plan is allowed only when complete usage is recorded and budget remains; filtering does not trigger a retry."],
      ["Separate product downloads", `Kernel ${releaseStatus.contextMemoryKernelVersion} stays unchanged. PC/mobile ${releaseStatus.productVersion} remain independent releases; the IDE updates recommend the paired CLI without a separate UI change.`],
    ]
  : [
      ["输出中断后保留当前任务", "达到输出上限或被服务商过滤时，不再误报任务完成。当前任务会保留，方便查看停止原因并决定下一步。"],
      ["不执行不完整的工具请求", "截断或过滤响应中的工具不会执行。输出截断后，只有用量完整入账且预算仍足够时，才允许至多一次重新规划；过滤不会触发重试。"],
      ["客户端继续独立升级", `Kernel ${releaseStatus.contextMemoryKernelVersion} 不变，PC / 移动端 ${releaseStatus.productVersion} 继续独立发行；本轮 IDE 更新推荐配套 CLI，没有单独的界面改动。`],
    ];
---

<section class="py-16 border-t border-line bg-cream" aria-labelledby="source-update-title">
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} · {english ? "Verified public release" : "已核验公开发行"} · CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english ? "CLI and IDE upgrade pairing" : "CLI 与 IDE 配套升级"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? `CLI ${releaseStatus.recommendedCliVersion}, Open VSX ${releaseStatus.openVsxVersion} and JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} are publicly verified. Both IDEs recommend CLI ${releaseStatus.recommendedCliVersion}. Context Memory Kernel ${releaseStatus.contextMemoryKernelVersion}, Session Core ${releaseStatus.sessionCoreVersion} and Personal Data Hub ${releaseStatus.personalDataHubVersion} are publicly available dependencies. Native product ${releaseStatus.productVersion} remains a separate download.`
        : `CLI ${releaseStatus.recommendedCliVersion}、Open VSX ${releaseStatus.openVsxVersion} 与 JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} 均已公开核验，两个 IDE 均推荐 CLI ${releaseStatus.recommendedCliVersion}。Context Memory Kernel ${releaseStatus.contextMemoryKernelVersion}、Session Core ${releaseStatus.sessionCoreVersion} 和 Personal Data Hub ${releaseStatus.personalDataHubVersion} 依赖均已公开；原生产品 ${releaseStatus.productVersion} 继续独立下载升级。`}
    </p>
    {jetBrainsPending && (
      <p class="mt-3 text-sm text-muted">
        {english
          ? `The newer JetBrains ${releaseStatus.jetBrainsCandidateVersion} upload awaits public listing and download verification.`
          : `较新的 JetBrains ${releaseStatus.jetBrainsCandidateVersion} 已上传，公开上架与下载仍待核验。`}
      </p>
    )}
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {english
        ? `Automatic task acceptance remains ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}, with ${releaseStatus.remainingUnaccepted} unaccepted. Three separately assisted regression deliveries are not automatic task successes. Local tests and publication add no accepted automatic tasks. Full Memory performance targets, semantic quality and dual-IDE acceptance remain incomplete.`
        : `自动任务验收仍为 ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}，剩余 ${releaseStatus.remainingUnaccepted} 项；另有 3 项人工辅助回归交付，不能计为自动任务成功；本地测试和发行也不增加自动成功数。完整 Memory 性能目标、真实语义和双 IDE 验收尚未全部完成。`}
    </p>
    <p class="mt-3 text-sm text-muted">
      {english
        ? `This product fix does not change the original evaluation broker or repair its historical failures. Compact MCP catalogs remain opt-in. Microsoft Marketplace is deferred; stock VS Code can install the versioned Open VSX VSIX.`
        : `本次产品修复不改变原评测 broker，也不把历史失败变成成功；紧凑 MCP 目录仍默认关闭。Microsoft Marketplace 暂缓，官方 VS Code 可安装 Open VSX 的版本化 VSIX。`}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn-ghost" href={`https://open-vsx.org/api/chainlesschain/chainlesschain-ide/${releaseStatus.openVsxVersion}/file/chainlesschain.chainlesschain-ide-${releaseStatus.openVsxVersion}.vsix`}>{english ? "Download VSIX" : "下载 VSIX"} {releaseStatus.openVsxVersion} ↗</a>
      <a class="btn-ghost" href={`https://plugins.jetbrains.com/plugin/download?updateId=${releaseStatus.jetBrainsUpdateId}`}>{english ? "Download JetBrains ZIP" : "下载 JetBrains ZIP"} {releaseStatus.jetBrainsMarketplaceVersion} ↗</a>
      <a class="btn-ghost" href={releaseStatus.upgradeGuide}>{english ? "Upgrade guide ↗" : "升级指南 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.evolutionConfigurationGuide}>{english ? "Self-evolution settings ↗" : "自进化开关配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.recoveryGuide}>{english ? "Image budgets and recovery ↗" : "图片预算与恢复 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.runtimeDesign}>{english ? "Runtime design ↗" : "运行时设计 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.releaseEvidence}>{english ? "Publication evidence ↗" : "发布核验回执 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-agent.html">{english ? "Agent conditions and review ↗" : "Agent 完成条件与复查 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-tool-search.html">{english ? "MCP catalog configuration ↗" : "MCP 目录配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.documentationReview.evidenceUrl}>{english ? "Documentation review ↗" : "代码与文档核对记录 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/goal-drafts-current.html">{english ? "Goal draft guide ↗" : "目标草稿指南 ↗"}</a>
    </div>
  </div>
</section>
