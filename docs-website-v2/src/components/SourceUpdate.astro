---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const items = english
  ? [
      [
        "Follow project goals",
        "Current desktop source persists personal goals and explicit risk monitoring. Review proposals, inspect the current task version and confirm native actions, then independently check business acceptance conditions.",
      ],
      [
        "Keep control of follow-up",
        "Stop one check, pause a goal or end follow-up with separate durable states. Checks, actions and acceptance share a budget; unresolved results keep their original receipt identity. Goals require the reviewed source.",
      ],
      [
        "Inspect RRSI evidence",
        "Source adds five-pool accounting, statistics v2, preregistration and Registry/History binding. Required quality receipts remain HOLD; real experiments, production origins and promotion gates remain incomplete.",
      ],
    ]
  : [
      [
        "项目目标与独立验收",
        "主线桌面源码保存个人目标并显式开启风险巡检。建议经当前版本预览、原生确认和业务回执处理，完成时独立读取业务事实核验条件。",
      ],
      [
        "持续跟进由你控制",
        "停止本次检查、暂停目标和结束跟进分别保存真实状态。检查、动作与验收共享预算，未知结果沿原回执核对；该工作区需运行本轮源码。",
      ],
      [
        "RRSI 评测与证据",
        "主线已实现五池计账、统计 v2、耐久预注册及 Registry/History 关联。必需质量回执保持 HOLD，真实实验、生产来源与晋级门仍待完成。",
      ],
    ];
---

<section
  class="py-16 border-t border-line bg-cream"
  aria-labelledby="source-update-title"
>
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      2026-10-07 · {english ? "Public release and current source" : "公开发布与主线源码"} · CLI{" "}
      {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english
        ? "Follow project goals and verify outcomes"
        : "持续跟进项目目标，独立核验业务结果"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? `CLI ${releaseStatus.recommendedCliVersion}, Open VSX ${releaseStatus.openVsxVersion} and JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} are public after their separate release gates. New project goals and RRSI require source reviewed at ${releaseStatus.sourceHeadCommit.slice(0, 10)}; they are outside these public artifacts and the separate v5.0.3.138 desktop installer.`
        : `CLI ${releaseStatus.recommendedCliVersion}、Open VSX ${releaseStatus.openVsxVersion} 与 JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} 已经各自发行门并公开。新项目目标与 RRSI 需运行核对至 ${releaseStatus.sourceHeadCommit.slice(0, 10)} 的源码，尚未进入这些公开制品或独立 v5.0.3.138 桌面安装包。`}
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <div class="mt-6 flex flex-wrap gap-4">
      <a
        class="btn-ghost"
        href="https://docs.chainlesschain.com/chainlesschain/project-goals-current.html"
      >
        {english ? "Project goal guide ↗" : "项目目标指南 ↗"}
      </a>
      <a
        class="btn-ghost"
        href="https://docs.chainlesschain.com/chainlesschain/rrsi-current.html"
      >
        {english ? "RRSI evidence and limits ↗" : "RRSI 证据与边界 ↗"}
      </a>
      <a
        class="btn-ghost"
        href="https://design.chainlesschain.com/project-goals-rrsi-update-2026-10-07.html"
      >
        {english ? "Architecture and contracts ↗" : "架构与契约 ↗"}
      </a>
    </div>
  </div>
</section>
