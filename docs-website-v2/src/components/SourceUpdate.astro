---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const jetBrainsPending = [
  "pending-review",
  "pending-approval",
  "published-unverified",
  "uploaded_public_listing_pending",
].includes(releaseStatus.jetBrainsPublicationStatus);
const items = english
  ? [
      [
        "Goal evidence and optional review",
        "Natural language Goal evaluation uses successful tool evidence from the current turn and reports checkpoint write failures. Optional --review-changes is off by default, uses existing permissions and budgets, and publishes final text only.",
      ],
      [
        "IDE models and tool discovery",
        "IDEs distinguish missing configuration from read failures and keep /model selection within its conversation. MCP and Skills improve multilingual discovery; compact MCP catalogs remain opt-in, and Memory retains full disk validation.",
      ],
      [
        "Mobile and PC release",
        `All five platform builds passed for ${releaseStatus.productVersion}. The 22 public assets match the CI manifest, and desktop updater metadata is verified. Desktop and mobile users upgrade their product package; IDE users install the paired CLI.`,
      ],
    ]
  : [
      [
        "Goal 证据与可选交付复查",
        "自然语言 Goal 使用本轮成功工具证据判定完成，检查点保存失败会明确暴露。可选 --review-changes 默认关闭，沿用原有权限与预算，开启后仅发布最终文本。",
      ],
      [
        "IDE 模型配置与工具发现",
        "IDE 区分未配置与读取失败，/model 选择仅覆盖当前会话。MCP 与 Skills 改进多语言检索；紧凑目录默认关闭，Memory 继续执行完整磁盘校验。",
      ],
      [
        "移动与 PC 产品已公开",
        `${releaseStatus.productVersion} 五平台构建通过，22 个公开资产匹配 CI 清单，桌面更新元数据已核验。桌面与移动端通过产品包升级，IDE 用户安装配套 CLI。`,
      ],
    ];
---

<section class="py-16 border-t border-line bg-cream" aria-labelledby="source-update-title">
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} · {english ? "Verified public release" : "已核验公开发行"} · CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english ? "Goal evidence, optional review and model configuration" : "Goal 证据、可选复查与模型配置"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? `CLI ${releaseStatus.recommendedCliVersion}, Open VSX ${releaseStatus.openVsxVersion} and JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} are publicly verified. Both IDEs recommend CLI ${releaseStatus.recommendedCliVersion}. Session Core ${releaseStatus.sessionCoreVersion} and Personal Data Hub ${releaseStatus.personalDataHubVersion} were published before the CLI. Native product ${releaseStatus.productVersion} remains a separate download.`
        : `CLI ${releaseStatus.recommendedCliVersion}、Open VSX ${releaseStatus.openVsxVersion} 与 JetBrains ${releaseStatus.jetBrainsMarketplaceVersion} 均已公开核验，两个 IDE 均推荐 CLI ${releaseStatus.recommendedCliVersion}。Session Core ${releaseStatus.sessionCoreVersion} 和 Personal Data Hub ${releaseStatus.personalDataHubVersion} 已先于 CLI 发布；原生产品 ${releaseStatus.productVersion} 继续独立下载升级。`}
    </p>
    {jetBrainsPending && (
      <p class="mt-3 text-sm text-muted">
        {english
          ? `The newer JetBrains ${releaseStatus.jetBrainsCandidateVersion} upload awaits public listing and download verification.`
          : `较新的 JetBrains ${releaseStatus.jetBrainsCandidateVersion} 已上传，公开上架与下载仍待核验。`}
      </p>
    )}
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {english
        ? `This documentation update adds no independent task acceptance. Historical cross-version acceptance remains ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}, with ${releaseStatus.remainingUnaccepted} unaccepted. NOT_PAID_READY, NOT_ADMITTED and automatic promotion HOLD remain.`
        : `本轮文档更新未新增独立任务验收。跨版本历史合格交付仍为 ${releaseStatus.cumulativeAcceptedDeliveries}/${releaseStatus.totalTaskSamples}，剩余 ${releaseStatus.remainingUnaccepted} 项；NOT_PAID_READY、NOT_ADMITTED 与自动晋升 HOLD 保留。`}
    </p>
    <p class="mt-3 text-sm text-muted">
      {english
        ? `Documentation reviewed at ${releaseStatus.sourceHeadCommit.slice(0, 10)}; published packages retain their own frozen source commits.`
        : `文档核对基线 ${releaseStatus.sourceHeadCommit.slice(0, 10)}；各公开制品保留独立冻结源码。`}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn-ghost" href={releaseStatus.upgradeGuide}>{english ? "Upgrade guide ↗" : "升级指南 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.evolutionConfigurationGuide}>{english ? "Self-evolution settings ↗" : "自进化开关配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.recoveryGuide}>{english ? "Image budgets and recovery ↗" : "图片预算与恢复 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.runtimeDesign}>{english ? "Runtime design ↗" : "运行时设计 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.releaseEvidence}>{english ? "Publication evidence ↗" : "发布核验回执 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-agent.html">{english ? "Agent conditions and review ↗" : "Agent 完成条件与复查 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-tool-search.html">{english ? "MCP catalog configuration ↗" : "MCP 目录配置 ↗"}</a>
      <a class="btn-ghost" href={releaseStatus.documentationReview.evidenceUrl}>{english ? "Documentation review ↗" : "代码与文档核对记录 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/goal-drafts-current.html">{english ? "Goal draft guide ↗" : "目标草稿指南 ↗"}</a>
    </div>
  </div>
</section>
