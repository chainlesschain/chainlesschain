---
import releaseStatus from "../data/release-status.json";
const { lang = "zh" } = Astro.props;
const english = lang === "en";
const jetBrainsPending = releaseStatus.jetBrainsPublicationStatus !== "verified";
const items = english
  ? [
      ["Public CLI and IDE pairing", "Public CLI .107 pairs with Open VSX .152 and JetBrains .169. Both IDEs recommend .107; their public artifacts and complete release gates are verified."],
      ["Goal drafts and desktop authorization", "CLI .107, Session Core .20 and the paired IDEs include authorized panels, offline handoff and online pending drafts. Desktop integration requires a matching source build, preview and native confirmation."],
      ["31 of 45 deliveries accepted", "The .105 retest collected all 20 records and added 6 accepted deliveries. Cumulative cross-version coverage is 31/45; 14 remain unaccepted. This is not a latest-version single-round success rate."],
    ]
  : [
      ["公开 CLI 与 IDE 配对", "CLI .107、Open VSX .152 与 JetBrains .169 已公开，两个 IDE 均推荐 .107；完整发行门及公开制品回读通过。"],
      ["目标草稿互通与桌面授权", "CLI .107、Session Core .20 与配对 IDE 已包含授权面板、离线移交及在线待审草稿；桌面互通仍需匹配源码构建、预览和逐次原生确认。"],
      ["累计合格交付 31/45", ".105 补测已收齐20项记录，新增6项合格；跨版本累计31/45，剩余14项。这不是最新版单轮成功率。"],
    ];
---

<section class="py-16 border-t border-line bg-cream" aria-labelledby="source-update-title">
  <div class="container-wide">
    <p class="font-mono text-sm text-muted">
      {releaseStatus.checkedAt} · {english ? "Public release and current source" : "公开发布与当前代码"} · CLI {releaseStatus.recommendedCliVersion}
    </p>
    <h2 id="source-update-title" class="mt-3 text-3xl font-bold">
      {english ? "Public releases and goal draft handoff" : "公开配对与目标草稿互通"}
    </h2>
    <p class="mt-4 text-muted leading-relaxed max-w-4xl">
      {english
        ? "CLI " + releaseStatus.recommendedCliVersion + " and Open VSX " + releaseStatus.openVsxVersion + " are publicly verified; Open VSX recommends CLI " + releaseStatus.openVsxRecommendedCliVersion + ". Public JetBrains " + releaseStatus.jetBrainsMarketplaceVersion + " recommends CLI " + releaseStatus.jetBrainsRecommendedCliVersion + ". Native product " + releaseStatus.productVersion + " remains a separate download."
        : "CLI " + releaseStatus.recommendedCliVersion + " 与 Open VSX " + releaseStatus.openVsxVersion + " 已公开核验；Open VSX 推荐 CLI " + releaseStatus.openVsxRecommendedCliVersion + "。公开 JetBrains " + releaseStatus.jetBrainsMarketplaceVersion + " 推荐 CLI " + releaseStatus.jetBrainsRecommendedCliVersion + "。原生产品 " + releaseStatus.productVersion + " 仍单独下载升级。"}
    </p>
    {jetBrainsPending && <p class="mt-3 text-sm text-muted">
      {english ? "JetBrains " + releaseStatus.jetBrainsCandidateVersion + " has been uploaded; public listing and download are not yet verified." : "JetBrains " + releaseStatus.jetBrainsCandidateVersion + " 已上传，公开上架与下载尚未核验。"}
    </p>}
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {items.map(([title, description]) => (
        <article class="rounded-xl border border-line bg-paper p-6">
          <h3 class="text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {english ? "This .107/.152/.169 release has no new model task retest. Session Core .20 is public. Native product .140 remains independently released; full native and long-term acceptance remain open." : "本次 .107/.152/.169 没有新的模型任务补测。Session Core .20 已公开；原生产品 .140 独立发行，完整原生与长期验收仍待完成。"}
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/cli-ide-update-2026-10-20.html">{english ? "Upgrade and troubleshooting ↗" : "升级与故障排查 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/goal-drafts-current.html">{english ? "Goal draft guide ↗" : "目标草稿使用指南 ↗"}</a>
      <a class="btn-ghost" href="https://docs.chainlesschain.com/chainlesschain/agent-platform-release.html">{english ? "Release guide ↗" : "发布与升级指南 ↗"}</a>
      <a class="btn-ghost" href="https://design.chainlesschain.com/release-runtime-update-2026-10-20.html">{english ? "Architecture and acceptance ↗" : "架构与验收范围 ↗"}</a>
    </div>
  </div>
</section>
