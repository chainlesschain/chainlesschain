{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chainlesschain.com/agent/cc-agent-protocol-v1.schema.json",
  "title": "ChainlessChain canonical Agent and Graph protocol",
  "description": "Provider-neutral Thread/Turn/Item, approval, tool, Agent Tree and GraphRun wire contract.",
  "x-cc-protocol": {
    "version": 1,
    "minimumCompatibleVersion": 1,
    "features": [
      "thread_turn_item",
      "structured_approval",
      "typed_graph",
      "causal_messages",
      "durable_human_task",
      "bounded_transport",
      "graph_effect_receipts",
      "deterministic_trace",
      "agent_stream_events"
    ]
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ClientRequest"
    },
    {
      "$ref": "#/$defs/ClientResponse"
    },
    {
      "$ref": "#/$defs/ServerRequest"
    },
    {
      "$ref": "#/$defs/ServerNotification"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "DataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "trust",
        "sensitivity",
        "allowedSinks"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trust": {
          "enum": [
            "trusted_host",
            "authenticated_user",
            "untrusted_content",
            "unknown"
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "secret"
          ]
        },
        "allowedSinks": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "declassificationDecisionId": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "Thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "createdAt",
        "updatedAt",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "active",
            "idle",
            "archived"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "parentThreadId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      }
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "threadId",
        "status",
        "createdAt",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "threadId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "waiting_approval",
            "waiting_input",
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "terminalEvidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "threadId",
        "turnId",
        "kind",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "threadId": {
          "$ref": "#/$defs/Identifier"
        },
        "turnId": {
          "$ref": "#/$defs/Identifier"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "user_message",
            "assistant_message",
            "reasoning",
            "tool",
            "approval",
            "plan",
            "subagent",
            "artifact",
            "error"
          ]
        },
        "status": {
          "enum": [
            "started",
            "streaming",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "content": {
          "$ref": "#/$defs/JsonValue"
        },
        "dataPolicy": {
          "$ref": "#/$defs/DataPolicy"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PermissionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "scope"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApprovalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "turnId",
        "itemId",
        "operationDigest",
        "policyDigest",
        "nonce",
        "expiresAt"
      ],
      "properties": {
        "threadId": {
          "$ref": "#/$defs/Identifier"
        },
        "turnId": {
          "$ref": "#/$defs/Identifier"
        },
        "itemId": {
          "$ref": "#/$defs/Identifier"
        },
        "attemptId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationDigest": {
          "$ref": "#/$defs/Digest"
        },
        "policyDigest": {
          "$ref": "#/$defs/Digest"
        },
        "workspaceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "nonce": {
          "$ref": "#/$defs/Identifier"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ApprovalDecision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "acceptOnce"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "acceptForTurn",
                "acceptForSession"
              ]
            },
            "permissions": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/PermissionGrant"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "decline",
                "cancel"
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      ]
    },
    "ApprovalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "binding",
        "operation",
        "risk",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "binding": {
          "$ref": "#/$defs/ApprovalBinding"
        },
        "operation": {
          "$ref": "#/$defs/JsonValue"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requestedPermissions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/PermissionGrant"
          }
        }
      }
    },
    "TerminalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eventDigest"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "partial",
            "cancelled",
            "blocked",
            "budget_exhausted"
          ]
        },
        "eventDigest": {
          "$ref": "#/$defs/Digest"
        },
        "outputDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "testReceiptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "TypedPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "schema": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "dataPolicy": {
          "$ref": "#/$defs/DataPolicy"
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0
        },
        "spawnCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TaskNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "dependsOn",
        "inputs",
        "outputs",
        "effectClass"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "task",
            "join",
            "human",
            "subgraph"
          ]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypedPort"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypedPort"
          }
        },
        "inputBindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "writeSet": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "workspaceIsolation": {
          "enum": [
            "worktree",
            "declared_scope"
          ]
        },
        "effectClass": {
          "enum": [
            "none",
            "read",
            "workspace_write",
            "external"
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "compensationNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "join": {
          "enum": [
            "all",
            "any",
            "quorum",
            "race"
          ]
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        },
        "retryLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "from": {
          "$ref": "#/$defs/Identifier"
        },
        "to": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "control",
            "data",
            "message",
            "review",
            "merge",
            "compensation"
          ]
        },
        "when": {
          "enum": [
            "success",
            "failure",
            "always",
            "timeout",
            "cancel"
          ]
        },
        "fromPort": {
          "$ref": "#/$defs/Identifier"
        },
        "toPort": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "LoopRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entryNodeId",
        "exitNodeId",
        "nodeIds",
        "maxIterations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "entryNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "exitNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      }
    },
    "TriggerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "targetNodeId",
        "authorityDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "manual",
            "schedule",
            "webhook",
            "message",
            "child_completion"
          ]
        },
        "targetNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "authorityDigest": {
          "$ref": "#/$defs/Digest"
        },
        "dataPolicy": {
          "$ref": "#/$defs/DataPolicy"
        }
      }
    },
    "Region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "nodeIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "sequence",
            "parallel",
            "condition",
            "try",
            "compensation"
          ]
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "parentRegionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "entryNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "exitNodeId": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "SubgraphCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "definitionId",
        "revisionDigest",
        "maxDepth"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "definitionId": {
          "$ref": "#/$defs/Identifier"
        },
        "revisionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "inputBindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SubgraphPortBinding"
          }
        },
        "outputBindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SubgraphPortBinding"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      }
    },
    "SubgraphPortBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentPort",
        "childNodeId",
        "childPort"
      ],
      "properties": {
        "parentPort": {
          "$ref": "#/$defs/Identifier"
        },
        "childNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "childPort": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "GraphDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "nodes",
        "edges",
        "loops",
        "subgraphCalls",
        "budget"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "triggers": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/TriggerBinding"
          }
        },
        "regions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/Region"
          }
        },
        "nodes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/TaskNode"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "loops": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/LoopRegion"
          }
        },
        "subgraphCalls": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/SubgraphCall"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "allowedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      }
    },
    "GraphRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "revision",
        "revisionDigest",
        "schemaVersion",
        "createdAt"
      ],
      "properties": {
        "definitionId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "revisionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "parentRevisionDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "producerLeaseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "IterationFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runId",
        "regionId",
        "iterationPath",
