{
  "name": "project-delivery-assistant",
  "version": "0.3.0",
  "description": "Project evidence, bounded observations, retained replay, description drafts and separately adopted task-creation request files",
  "permissions": {
    "goalExtension": [
      "event:goal.status.changed",
      "event:risk.review.completed",
      "event:action.receipt.updated",
      "panel:goal.evidence",
      "proposal:task.description.update",
      "proposal:task.create"
    ]
  },
  "goalExtension": {
    "apiVersion": "1.0.0",
    "hosts": {
      "cli": ">=0.166.143",
      "vscode": ">=0.37.179",
      "jetbrains": ">=0.4.196"
    },
    "events": [
      "goal.status.changed",
      "risk.review.completed",
      "action.receipt.updated"
    ],
    "panels": [
      {
        "id": "delivery-evidence",
        "title": "Project delivery evidence",
        "slot": "goal.evidence",
        "fields": ["objective", "status", "riskSummary", "receiptSummary"],
        "fallback": "text"
      }
    ],
    "proposals": ["task.description.update", "task.create"]
  }
}
