{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainlesschain.com/schemas/context-memory-kernel/v1",
  "title": "ChainlessChain Context/Memory Kernel v1",
  "description": "Self-contained wire contracts for canonical context planning, compaction, memory lifecycle, deletion, and reconciliation.",
  "x-cc-context-memory": {
    "version": 1,
    "minimumCompatibleVersion": 1,
    "runtimeInvariants": [
      "context_item_exactly_one_content_source",
      "scope_id_required_except_global",
      "tool_call_result_atomicity",
      "protected_recovery_state",
      "scope_trust_sensitivity_non_escalation",
      "memory_tombstone_replica_fencing"
    ]
  },
  "anyOf": [
    { "$ref": "#/$defs/ContextItem" },
    { "$ref": "#/$defs/MemoryRecord" },
    { "$ref": "#/$defs/ContextPlanRequest" },
    { "$ref": "#/$defs/ContextPlan" },
    { "$ref": "#/$defs/ContextCompactRequest" },
    { "$ref": "#/$defs/ContextCompactionReceipt" },
    { "$ref": "#/$defs/MemoryRecallRequest" },
    { "$ref": "#/$defs/MemoryRecallResult" },
    { "$ref": "#/$defs/MemoryProposalRequest" },
    { "$ref": "#/$defs/MemoryDecisionRequest" },
    { "$ref": "#/$defs/MemoryDeletionRequest" },
    { "$ref": "#/$defs/MemoryReconcileRequest" },
    { "$ref": "#/$defs/MemoryMutationReceipt" },
    { "$ref": "#/$defs/MemoryDeletionReceipt" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "JsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "ContextMemoryScope": {
      "enum": ["turn", "session", "agent", "project", "user", "global"]
    },
    "ContextMemoryTrust": {
      "enum": ["host", "verified", "user", "external", "untrusted"]
    },
    "ContextMemorySensitivity": {
      "enum": ["public", "internal", "personal", "secret", "restricted"]
    },
    "ContextMemorySourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "id"],
      "properties": {
        "store": { "$ref": "#/$defs/Identifier" },
        "id": { "$ref": "#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 0 },
        "eventSequence": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "#/$defs/Digest" },
        "uri": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "ContextMemoryProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt"],
      "properties": {
        "source": { "$ref": "#/$defs/Identifier" },
        "actor": { "$ref": "#/$defs/Identifier" },
        "observedAt": { "$ref": "#/$defs/Timestamp" },
        "parentDigests": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Digest" }
        },
        "degraded": { "type": "boolean" }
      }
    },
    "ContextMemoryContentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "objectId",
        "digest",
        "byteLength",
        "summary",
        "recoverable"
      ],
      "properties": {
        "store": { "$ref": "#/$defs/Identifier" },
        "objectId": { "$ref": "#/$defs/Identifier" },
        "digest": { "$ref": "#/$defs/Digest" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "recoverable": { "type": "boolean" },
        "accessPolicy": { "$ref": "#/$defs/Identifier" }
      }
    },
    "ContextMemoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskState": { "enum": ["pending", "running", "waiting", "terminal"] },
        "toolCallId": { "$ref": "#/$defs/Identifier" },
        "toolRole": { "enum": ["call", "result"] },
        "toolOutcome": { "enum": ["pending", "succeeded", "failed", "unknown"] },
        "approvalId": { "$ref": "#/$defs/Identifier" },
        "questionId": { "$ref": "#/$defs/Identifier" },
        "humanTaskId": { "$ref": "#/$defs/Identifier" },
        "requiredForRecovery": { "type": "boolean" },
        "cwdIdentity": { "$ref": "#/$defs/Identifier" },
        "worktreeIdentity": { "$ref": "#/$defs/Identifier" },
        "permissionCeilingDigest": { "$ref": "#/$defs/Digest" },
        "budgetRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "ContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "itemId",
        "kind",
        "scope",
        "sourceRef",
        "provenance",
        "trust",
        "sensitivity",
        "allowedSinks",
        "tokenEstimate",
        "priority",
        "pinned",
        "createdAt",
        "digest"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "itemId": { "$ref": "#/$defs/Identifier" },
        "kind": {
          "enum": [
            "system-policy",
            "tool-schema",
            "skill",
            "task-state",
            "message",
            "tool-evidence",
            "memory",
            "project-rule",
            "artifact-ref"
          ]
        },
        "scope": { "$ref": "#/$defs/ContextMemoryScope" },
        "scopeId": { "$ref": "#/$defs/Identifier" },
        "sourceRef": { "$ref": "#/$defs/ContextMemorySourceRef" },
        "provenance": { "$ref": "#/$defs/ContextMemoryProvenance" },
        "trust": { "$ref": "#/$defs/ContextMemoryTrust" },
        "sensitivity": { "$ref": "#/$defs/ContextMemorySensitivity" },
        "allowedSinks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "tokenEstimate": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "pinned": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "expiresAt": { "$ref": "#/$defs/Timestamp" },
        "digest": { "$ref": "#/$defs/Digest" },
        "content": { "type": "string", "maxLength": 4194304 },
        "contentRef": { "$ref": "#/$defs/ContextMemoryContentRef" },
        "binding": { "$ref": "#/$defs/ContextMemoryBinding" }
      }
    },
    "ContextMemoryRetentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["ephemeral", "session", "durable", "until_expired", "legal_hold"]
        },
        "expiresAt": { "$ref": "#/$defs/Timestamp" },
        "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 365000 },
        "legalHoldId": { "$ref": "#/$defs/Identifier" }
      }
    },
    "MemoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "memoryId",
        "scope",
        "category",
        "content",
        "provenance",
        "evidenceRefs",
        "confidence",
        "importance",
        "tags",
        "sensitivity",
        "allowedSinks",
        "state",
        "retentionPolicy",
        "createdAt",
        "updatedAt",
        "accessCount",
        "revision",
        "digest"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "memoryId": { "$ref": "#/$defs/Identifier" },
        "scope": { "$ref": "#/$defs/ContextMemoryScope" },
        "scopeId": { "$ref": "#/$defs/Identifier" },
        "category": { "$ref": "#/$defs/Identifier" },
        "content": { "type": "string", "maxLength": 4194304 },
        "contentRef": { "$ref": "#/$defs/ContextMemoryContentRef" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "provenance": { "$ref": "#/$defs/ContextMemoryProvenance" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ContextMemorySourceRef" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "sensitivity": { "$ref": "#/$defs/ContextMemorySensitivity" },
        "allowedSinks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "state": {
          "enum": [
            "candidate",
            "active",
            "reinforced",
            "superseded",
            "archived",
            "expired",
            "deleted",
            "purged"
          ]
        },
        "retentionPolicy": { "$ref": "#/$defs/ContextMemoryRetentionPolicy" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "lastAccessedAt": { "$ref": "#/$defs/Timestamp" },
        "accessCount": { "type": "integer", "minimum": 0 },
        "supersedes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/Digest" },
        "deletionFence": { "$ref": "#/$defs/Identifier" }
      }
    },
    "ContextScopeAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "$ref": "#/$defs/ContextMemoryScope" },
        "scopeId": { "$ref": "#/$defs/Identifier" }
      }
    },
    "ContextPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelWindowTokens",
        "reservedOutputTokens",
        "items",
        "sink",
        "scopeAdmissions",
        "policyVersion",
        "modelProfile",
        "sessionHead",
        "memoryRevision"
      ],
      "properties": {
        "modelWindowTokens": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "reservedOutputTokens": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "safetyMarginTokens": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "recoveryReserveTokens": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/ContextItem" }
        },
        "sink": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scopeAdmissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ContextScopeAdmission" }
        },
        "partitionCeilings": { "$ref": "#/$defs/ContextPartitionMap" },
        "partitionMinimums": { "$ref": "#/$defs/ContextPartitionMap" },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelProfile": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sessionHead": { "type": "string", "minLength": 1, "maxLength": 256 },
        "memoryRevision": { "type": "integer", "minimum": 0 },
        "now": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ContextPartitionMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trusted-system": { "type": "integer", "minimum": 0 },
        "working-state": { "type": "integer", "minimum": 0 },
        "tools-and-skills": { "type": "integer", "minimum": 0 },
        "conversation": { "type": "integer", "minimum": 0 },
        "tool-evidence": { "type": "integer", "minimum": 0 },
        "memory-and-rules": { "type": "integer", "minimum": 0 }
      }
    },
    "ContextPlan": {
      "type": "object",
      "required": [
        "schema",
        "schemaVersion",
        "sessionHead",
        "memoryRevision",
        "policyVersion",
        "modelProfile",
        "sink",
        "inputBudget",
        "selectableBudget",
        "selectedTokens",
        "partitions",
        "selected",
        "selectedItemIds",
        "dropped",
        "createdAt",
        "digest"
      ],
      "properties": {
        "schema": { "const": "chainlesschain.context-plan/v1" },
        "schemaVersion": { "const": 1 },
        "sessionHead": { "type": "string", "minLength": 1, "maxLength": 256 },
        "memoryRevision": { "type": "integer", "minimum": 0 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelProfile": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sink": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inputBudget": { "type": "integer", "minimum": 1 },
        "selectableBudget": { "type": "integer", "minimum": 1 },
        "selectedTokens": { "type": "integer", "minimum": 0 },
        "partitions": { "type": "object" },
        "minimumShortfalls": { "type": "object" },
        "selected": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/ContextItem" }
        },
        "selectedItemIds": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "dropped": {
          "type": "array",
          "maxItems": 100000,
          "items": { "type": "object" }
        },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "ContextCompactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "sessionId",
        "modelWindowTokens",
        "reservedOutputTokens",
        "sink",
        "scopeAdmissions",
        "policyVersion",
        "modelProfile"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/Identifier" },
        "sessionId": { "$ref": "#/$defs/Identifier" },
        "modelWindowTokens": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "reservedOutputTokens": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "safetyMarginTokens": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "recoveryReserveTokens": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sink": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scopeAdmissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ContextScopeAdmission" }
        },
        "partitionCeilings": { "$ref": "#/$defs/ContextPartitionMap" },
        "partitionMinimums": { "$ref": "#/$defs/ContextPartitionMap" },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelProfile": { "type": "string", "minLength": 1, "maxLength": 256 },
        "memoryRevision": { "type": "integer", "minimum": 0 },
        "allowFallback": { "type": "boolean" },
        "now": { "$ref": "#/$defs/Timestamp" },
        "metadata": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "ContextCompactionReceipt": {
      "type": "object",
      "required": [
        "schema",
        "schemaVersion",
        "operationId",
        "sessionId",
        "status",
        "digest"
      ],
      "properties": {
        "schema": { "const": "chainlesschain.context-compaction/v1" },
        "schemaVersion": { "const": 1 },
        "operationId": { "$ref": "#/$defs/Identifier" },
        "sessionId": { "$ref": "#/$defs/Identifier" },
        "status": {
          "enum": ["committed", "degraded", "stale", "reconciliation_required"]
        },
        "inputHead": { "type": "string", "maxLength": 256 },
        "newHead": { "type": "string", "maxLength": 256 },
        "currentHead": { "type": ["string", "null"], "maxLength": 256 },
        "inputDigest": { "$ref": "#/$defs/Digest" },
        "outputDigest": { "$ref": "#/$defs/Digest" },
        "eventDigest": { "$ref": "#/$defs/Digest" },
        "contextPlanDigest": { "$ref": "#/$defs/Digest" },
        "memoryRevision": { "type": "integer", "minimum": 0 },
        "selectedItemIds": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "lifecycle": { "type": "array", "maxItems": 32, "items": { "type": "object" } },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "MemoryRecallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "sink", "scopeAdmissions"],
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "sink": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scopeAdmissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ContextScopeAdmission" }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "tokenBudget": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "now": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MemoryRecallResult": {
      "type": "object",
      "required": [
        "query",
        "sink",
        "tokenBudget",
        "usedTokens",
        "totalCandidates",
        "results",
        "digest",
        "memoryRevision"
      ],
      "properties": {
        "query": { "type": "string" },
        "sink": { "type": "string" },
        "tokenBudget": { "type": "integer", "minimum": 1 },
        "usedTokens": { "type": "integer", "minimum": 0 },
        "totalCandidates": { "type": "integer", "minimum": 0 },
        "results": { "type": "array", "maxItems": 1000, "items": { "type": "object" } },
        "digest": { "$ref": "#/$defs/Digest" },
        "memoryRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "MemoryProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "category",
        "content",
        "provenance",
        "evidenceRefs",
        "confidence",
        "importance",
        "sensitivity",
        "allowedSinks",
        "retentionPolicy"
      ],
      "properties": {
        "memoryId": { "$ref": "#/$defs/Identifier" },
        "scope": { "$ref": "#/$defs/ContextMemoryScope" },
        "scopeId": { "$ref": "#/$defs/Identifier" },
        "category": { "$ref": "#/$defs/Identifier" },
        "content": { "type": "string", "minLength": 1, "maxLength": 4194304 },
        "contentRef": { "$ref": "#/$defs/ContextMemoryContentRef" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "provenance": { "$ref": "#/$defs/ContextMemoryProvenance" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ContextMemorySourceRef" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 128 } },
        "sensitivity": { "$ref": "#/$defs/ContextMemorySensitivity" },
        "allowedSinks": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 128 } },
        "retentionPolicy": { "$ref": "#/$defs/ContextMemoryRetentionPolicy" },
        "activate": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "supersedes": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Identifier" } }
      }
    },
    "MemoryDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryId", "type", "expectedRevision"],
      "properties": {
        "memoryId": { "$ref": "#/$defs/Identifier" },
        "type": { "enum": ["activate", "reinforce", "supersede", "archive", "expire"] },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "confidenceDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceRefs": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/ContextMemorySourceRef" } },
        "tags": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 128 } },
        "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "successorMemoryId": { "$ref": "#/$defs/Identifier" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "authority": { "$ref": "#/$defs/Identifier" },
        "at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MemoryDeletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "subject",
        "scope",
        "selector",
        "memoryId",
        "expectedRevision",
        "fence",
        "authority"
      ],
      "properties": {
        "requestId": { "$ref": "#/$defs/Identifier" },
        "subject": { "$ref": "#/$defs/Identifier" },
        "scope": { "$ref": "#/$defs/ContextMemoryScope" },
        "scopeId": { "$ref": "#/$defs/Identifier" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
        "memoryId": { "$ref": "#/$defs/Identifier" },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "fence": { "$ref": "#/$defs/Identifier" },
        "authority": { "$ref": "#/$defs/Identifier" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "MemoryReconcileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/Identifier" }
      }
    },
    "MemoryMutationReceipt": {
      "type": "object",
      "required": ["record", "event", "receipt"],
      "properties": {
        "record": { "$ref": "#/$defs/MemoryRecord" },
        "event": { "type": "object" },
        "receipt": { "type": "object" }
      }
    },
    "MemoryDeletionReceipt": {
      "type": "object",
      "required": [
        "schema",
        "schemaVersion",
        "requestId",
        "subject",
        "selector",
        "scope",
        "memoryId",
        "fence",
        "authority",
        "status",
        "revision",
        "recordState",
        "recordDigest",
        "stores",
        "startedAt",
        "completedAt",
        "digest"
      ],
      "properties": {
        "schema": { "const": "chainlesschain.memory-deletion-receipt/v1" },
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "#/$defs/Identifier" },
        "subject": { "$ref": "#/$defs/Identifier" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
        "scope": { "$ref": "#/$defs/ContextMemoryScope" },
        "scopeId": { "$ref": "#/$defs/Identifier" },
        "memoryId": { "$ref": "#/$defs/Identifier" },
        "fence": { "$ref": "#/$defs/Identifier" },
        "authority": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["partial", "reconciliation_required", "purged"] },
        "revision": { "type": "integer", "minimum": 1 },
        "recordState": { "enum": ["deleted", "purged"] },
        "recordDigest": { "$ref": "#/$defs/Digest" },
        "stores": { "type": "array", "maxItems": 129, "items": { "type": "object" } },
        "startedAt": { "$ref": "#/$defs/Timestamp" },
        "completedAt": { "$ref": "#/$defs/Timestamp" },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    }
  }
}
