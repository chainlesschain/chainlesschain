{
  "schema": "chainlesschain.context-memory-writer-inventory/v1",
  "version": 1,
  "requiredSurfaces": [
    "shared",
    "session_core",
    "cli",
    "desktop",
    "vscode",
    "jetbrains",
    "sdk"
  ],
  "cutoverStages": [
    "inventory",
    "shadow",
    "internal_canary",
    "opt_in_canary",
    "canonical_default",
    "legacy_read_only",
    "retired"
  ],
  "discovery": {
    "roots": [
      "packages/session-core/lib",
      "packages/cli/src",
      "desktop-app-vue/src/main",
      "packages/vscode-extension/src",
      "packages/jetbrains-plugin/src/main"
    ],
    "writerPatterns": [
      "\\b(?:MemoryStore|MemoryConsolidator|PromptCompressor|CLIPermanentMemory|HierarchicalMemory|PermanentMemoryManager|MemoryHierarchy|MemGPTCore|MemorySyncService)\\b",
      "\\b(?:compactConversationWithProvider|appendCompactEvent(?:IfMessagesMatch)?|addMemory|deleteMemory|importMemory|updateMemoryFile)\\s*\\(",
      "(?:INSERT\\s+INTO|UPDATE|DELETE\\s+FROM)\\s+(?:permanent_)?memor",
      "(?:s::compact|[\"']\\/compact[\"']|memory files|ProjectMemory)"
    ],
    "extensions": [".js", ".cjs", ".mjs", ".ts", ".java", ".kt"],
    "excludedSegments": ["node_modules", "__tests__"],
    "excludedSuffixes": [".test.js", ".test.ts", ".d.ts"]
  },
