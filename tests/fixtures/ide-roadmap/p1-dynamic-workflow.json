{
  "schemaVersion": 1,
  "case": "p1-dynamic-workflow",
  "description": "A model-proposed workflow must remain non-executable until exact-digest human review, then replay the accepted version across declared hosts and execution locations with durable control, at-most-once stage settlement, bounded cost, and complete artifact lineage.",
  "inputs": {
    "definitionModes": [
      "batched-dag",
      "pipeline",
      "literal-for-each",
      "bounded-loop",
      "retry-timeout"
    ],
    "lifecycle": [
      "generate-draft",
      "reject-draft",
      "accept-exact-digest",
      "execute",
      "pause",
      "resume",
      "stop",
      "restart",
      "replay-accepted-version"
    ],
    "failureInjections": [
      "model-prose-instead-of-json",
      "model-secret-output",
      "model-review-authority-forgery",
      "draft-byte-tamper",
      "stale-review-digest",
      "definition-version-drift",
      "pause-before-stage-effect",
      "provider-success-before-stage-settlement-crash",
      "settlement-response-loss",
      "resume-with-stale-control-revision",
      "stop-resume-race",
      "artifact-write-failure",
      "token-budget-exhaustion",
      "execution-authority-drift",
      "plugin-package-tamper"
    ],
    "scale": {
      "minimumIndependentRunsPerCell": 100,
      "maximumExpandedTasks": 64,
      "requiredRuntimeMeasurements": [
        "stage-duration-ms",
        "input-tokens",
        "output-tokens",
        "estimated-usd",
        "checkpoint-count",
        "artifact-bytes"
      ]
    }
  },
  "expectedOutcome": {
    "modelDraftDirectExecutionCount": 0,
    "reviewDigestMismatchAcceptanceCount": 0,
    "credentialLeakCount": 0,
    "unversionedDefinitionExecutionCount": 0,
    "authorityDriftExecutionCount": 0,
    "duplicateStageSettlementCount": 0,
    "stoppedStageCommitCount": 0,
    "budgetOverrunContinuationCount": 0,
    "missingArtifactLineageCount": 0,
    "unsupportedNeedsInputContinuationCount": 0,
    "requiredMeasurementsComplete": true,
    "humanReviewBound": true,
    "exactCommitBound": true
  }
}
